---
// Certifa mark: a node with an attack path climbing out of it.
// Matches public/favicon.svg. Inherits colour from the parent via currentColor.
interface Props {
  class?: string;
}
const { class: className = 'w-5 h-5' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M7.1 13.4 L10.1 15.2 L10.1 18.6 L7.1 20.3 L4.1 18.6 L4.1 15.2 Z" />
  <path d="M7.1 13.4 V10.9 L10.5 7.5 L13.9 10.9 L16.1 6 L19.9 3" />
</svg>
