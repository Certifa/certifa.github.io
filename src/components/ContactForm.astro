---
// Editor-motif contact form, shared by the homepage and /contact. The two
// exports style the chrome slightly differently (filled vs outlined submit,
// left vs centred filename), so that varies by `variant`; the validation,
// honeypot and Worker call are defined once.
interface Props {
  id: string;
  variant?: 'filled' | 'outlined';
}

const { id, variant = 'filled' } = Astro.props;

const submitClass =
  variant === 'filled'
    ? 'px-6 py-2 rounded bg-accent text-bg font-mono font-bold text-xs hover:bg-[#3fca70] transition-colors flex items-center gap-2 active:translate-y-px disabled:opacity-60'
    : 'px-5 py-2 bg-transparent border border-accent rounded text-sm text-accent hover:bg-accent/10 transition-colors font-medium disabled:opacity-60';
---

<div class="bg-bg border border-border rounded-xl overflow-hidden flex flex-col justify-between h-full">
  <!-- Editor tab bar -->
  <div
    class:list={[
      'flex items-center px-4 py-2 border-b border-border bg-surface relative',
      variant === 'outlined' ? 'justify-center py-3' : 'justify-between',
    ]}
  >
    <div class:list={['flex items-center gap-1.5', variant === 'outlined' && 'absolute left-4']} aria-hidden="true">
      <span class="w-2.5 h-2.5 rounded-full bg-zinc-800"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-zinc-800"></span>
      <span class="w-2.5 h-2.5 rounded-full bg-zinc-800"></span>
    </div>
    <span class="font-mono text-[10px] text-muted">contact_form.go</span>
    {variant === 'filled' && <div class="w-12"></div>}
  </div>

  <form id={id} novalidate data-contact-form class="flex flex-col justify-between flex-1">
    <div class="p-6 md:p-8 flex flex-col gap-6">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="font-mono text-[10px] text-zinc-600">01</span>
          <span class="font-mono text-[11px] text-purple-400">var</span>
          <label for={`${id}-email`} class="font-mono text-[11px] text-teal-400">Email</label>
          <span class="font-mono text-[11px] text-muted">=</span>
        </div>
        <div class="pl-6 border-l border-border">
          <input
            id={`${id}-email`}
            data-field="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@domain.dev"
            class="w-full bg-transparent border-b border-zinc-800 focus:border-teal-400 text-base md:text-sm font-mono text-teal-400 placeholder-zinc-700 py-2 focus:outline-none transition-colors"
          />
        </div>
      </div>

      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="font-mono text-[10px] text-zinc-600">02</span>
          <span class="font-mono text-[11px] text-purple-400">const</span>
          <label for={`${id}-msg`} class="font-mono text-[11px] text-teal-400">OneLine</label>
          <span class="font-mono text-[11px] text-muted">=</span>
        </div>
        <div class="pl-6 border-l border-border">
          <textarea
            id={`${id}-msg`}
            data-field="message"
            name="message"
            rows="3"
            required
            minlength="3"
            placeholder="hey certifa, i'm working on..."
            class="w-full bg-transparent border-b border-zinc-800 focus:border-purple-400 text-base md:text-sm font-mono text-zinc-300 placeholder-zinc-700 py-2 focus:outline-none transition-colors resize-none"
          ></textarea>
        </div>
      </div>

      <input data-field="botcheck" name="botcheck" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
      <p data-field="error" hidden class="font-mono text-[11px] text-amber-500"></p>
    </div>

    <div class="px-6 py-4 bg-surface border-t border-border flex items-center justify-between gap-4">
      <span data-field="status" class="font-mono text-[10px] text-muted flex items-center gap-2">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        ready to compile
      </span>
      <button data-field="submit" type="submit" class={submitClass}>go run send.go</button>
    </div>
  </form>
</div>

<script>
  const ENDPOINT =
    location.hostname === 'localhost' || location.hostname === '127.0.0.1'
      ? 'http://localhost:8787/submit'
      : 'https://forms.certifa.net/submit';

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const q = <T extends HTMLElement>(name: string) =>
      form.querySelector(`[data-field="${name}"]`) as T | null;

    const email = q<HTMLInputElement>('email');
    const msg = q<HTMLTextAreaElement>('message');
    const bot = q<HTMLInputElement>('botcheck');
    const btn = q<HTMLButtonElement>('submit');
    const status = q<HTMLElement>('status');
    const errorEl = q<HTMLElement>('error');
    if (!email || !msg || !bot || !btn || !status || !errorEl) return;

    const succeed = () => {
      form.innerHTML = '<p class="p-8 font-mono text-sm text-accent">// got it. I\'ll get back to you.</p>';
    };

    const fail = (text: string) => {
      btn.disabled = false;
      btn.textContent = 'go run send.go';
      status.textContent = 'build failed';
      errorEl.textContent = text;
      errorEl.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;

      // Honeypot: filled means a bot, so report success without sending.
      if (bot.value.trim() !== '') return succeed();

      const emailVal = email.value.trim();
      const msgVal = msg.value.trim();

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailVal)) {
        errorEl.textContent = '// need a valid email address';
        errorEl.hidden = false;
        email.focus();
        return;
      }
      if (msgVal.length < 3) {
        errorEl.textContent = '// message needs at least 3 characters';
        errorEl.hidden = false;
        msg.focus();
        return;
      }

      btn.disabled = true;
      btn.textContent = 'compiling...';
      status.textContent = 'sending';

      try {
        const res = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailVal, message: msgVal, botcheck: '' }),
        });
        const data = await res.json().catch(() => ({ ok: false }));
        if (res.ok && data.ok) succeed();
        else fail("// didn't go through, try again or email me directly");
      } catch {
        fail('// no connection, check your network and retry');
      }
    });
  });
</script>
