---
// The alternating two-column writeup row from the Page_1 export ("Threat
// Intelligence Logs"), including its stock imagery and hover treatment.
interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  difficulty: string;
  platform: string;
  kicker: string;
  image: string;
  imageAlt: string;
  imageFilter: string;
  overlay: string;
  flip?: boolean;
}

const {
  slug, title, description, tags, difficulty, platform, kicker,
  image, imageAlt, imageFilter, overlay, flip = false,
} = Astro.props;

const category = platform === 'HTB' ? 'HTB_MACHINE' : `${platform}_ENTRY`;
const shownTags = tags.slice(0, 3);

const dither =
  "background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E'); mix-blend-mode: overlay;";
---

<a
  href={`/writeups/${slug}/`}
  class="group grid grid-cols-1 md:grid-cols-2 gap-12 items-center transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(74,222,128,0.05)] rounded-[2rem] p-4 -m-4"
  data-reveal
>
  <div
    class:list={[
      'relative rounded-[1.25rem] overflow-hidden border border-border bg-surface p-2 aspect-[16/10]',
      flip ? 'order-2' : 'order-2 md:order-1',
    ]}
  >
    <div class:list={['absolute inset-0 mix-blend-multiply z-10 pointer-events-none transition-colors duration-500', overlay]}></div>
    <div class="absolute inset-0 z-20 pointer-events-none opacity-20" style={dither}></div>
    <img
      src={image}
      alt={imageAlt}
      loading="lazy"
      decoding="async"
      class:list={[
        'w-full h-full object-cover rounded-xl group-hover:scale-105 transition-transform duration-700 ease-out',
        imageFilter,
      ]}
    />
  </div>

  <div class:list={['flex flex-col items-start', flip ? 'order-1' : 'order-1 md:order-2']}>
    <div class="flex items-center gap-4 mb-6">
      <span class="font-mono text-[10px] text-zinc-300 uppercase tracking-wider px-2.5 py-1 border border-border rounded-md bg-white/5">{category}</span>
      <span class="w-8 h-px bg-border" aria-hidden="true"></span>
      <span class="font-mono text-[10px] text-zinc-500 uppercase tracking-wider">{kicker}</span>
    </div>

    <h3 class="font-display text-3xl lg:text-4xl font-semibold tracking-tighter text-fg group-hover:text-white transition-colors mb-4">
      {title}
    </h3>

    <p class="text-muted leading-relaxed mb-8 max-w-lg line-clamp-3">
      {description}
    </p>

    <div class="flex flex-wrap gap-3">
      {shownTags.map((tag) => (
        <span class="px-3 py-1.5 rounded-md border border-border font-mono text-[11px] text-zinc-300">{tag}</span>
      ))}
      <span class={`diff-pill diff-${difficulty}`}>{difficulty}</span>
    </div>
  </div>
</a>
