---
// The alternating two-column writeup row from the Page_1 export ("Threat
// Intelligence Logs"). The export's stock photography was replaced with the
// real box art the writeups listing already uses, so each row shows the box it
// actually links to. Boxes without art fall back to the code motif.
import CardMotif from './CardMotif.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  tags: string[];
  difficulty: string;
  platform: string;
  kicker: string;
  avatar: string | null;
  flip?: boolean;
}

const {
  slug, title, description, tags, difficulty, platform, kicker,
  avatar, flip = false,
} = Astro.props;

const category = platform === 'HTB' ? 'HTB_MACHINE' : `${platform}_ENTRY`;
const shownTags = tags.slice(0, 3);

// The export ordered the visual first and flipped it on alternate rows. Kept,
// so the column order stays identical whichever visual is rendered.
const visualOrder = flip ? 'order-2' : 'order-2 md:order-1';
---

<a
  href={`/writeups/${slug}/`}
  class="group grid grid-cols-1 md:grid-cols-2 gap-12 items-center transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(74,222,128,0.05)] rounded-[2rem] p-4 -m-4"
  data-reveal
>
  {avatar ? (
    <div
      class:list={[
        'relative rounded-[1.25rem] overflow-hidden border border-border bg-bg aspect-[16/10] flex items-center justify-center',
        visualOrder,
      ]}
    >
      <div
        class="absolute inset-0 opacity-50 group-hover:opacity-90 transition-opacity duration-500"
        style="background-image: radial-gradient(circle at center, rgba(74,222,128,0.14) 0%, transparent 68%);"
        aria-hidden="true"
      ></div>
      <img
        src={avatar}
        alt=""
        loading="lazy"
        decoding="async"
        class="relative h-28 w-28 lg:h-36 lg:w-36 object-contain group-hover:scale-105 transition-transform duration-700 ease-out"
      />
    </div>
  ) : (
    <CardMotif slug={slug} tags={tags} class={`aspect-[16/10] ${visualOrder}`} />
  )}

  <div class:list={['flex flex-col items-start min-w-0', flip ? 'order-1' : 'order-1 md:order-2']}>
    <div class="flex items-center gap-4 mb-6">
      <span class="font-mono text-[10px] text-zinc-300 uppercase tracking-wider px-2.5 py-1 border border-border rounded-md bg-white/5">{category}</span>
      <span class="w-8 h-px bg-border" aria-hidden="true"></span>
      <span class="font-mono text-[10px] text-muted uppercase tracking-wider">{kicker}</span>
    </div>

    <h3 class="font-display text-3xl lg:text-4xl font-semibold tracking-tighter text-fg group-hover:text-white transition-colors mb-4">
      {title}
    </h3>

    <p class="text-muted leading-relaxed mb-8 max-w-lg line-clamp-3">
      {description}
    </p>

    <div class="flex flex-wrap gap-3">
      {shownTags.map((tag) => (
        <span class="px-3 py-1.5 rounded-md border border-border font-mono text-[11px] text-zinc-300">{tag}</span>
      ))}
      <span class={`diff-pill diff-${difficulty}`}>{difficulty}</span>
    </div>
  </div>
</a>
