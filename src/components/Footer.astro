---
// The dithered "certifa" wordmark closes every page. The canvas is drawn by
// the shared script in BaseLayout; this just supplies the element and the row.
const year = new Date().getFullYear();
---

<footer class="foot">
  <canvas id="wordmark" aria-label="certifa" role="img"></canvas>
  <div class="foot-row">
    <span>Offensive security, Utrecht</span>
    <span>{year} Certifa</span>
  </div>
</footer>
