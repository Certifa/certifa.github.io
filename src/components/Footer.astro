---
// Follows the Page_22 footer, the most complete of the four in the exports.
// The exports hardcode "© 2024" and "certifa.dev"; the year is derived at build
// and the domain corrected to the one this site actually deploys to.
const year = new Date().getFullYear();

const links = [
  { href: 'https://github.com/Certifa', label: 'github' },
  { href: 'https://app.hackthebox.com/users/Certifa', label: 'hackthebox' },
  { href: 'https://www.linkedin.com/in/certifa', label: 'linkedin' },
];
---

<footer class="border-t border-border bg-bg py-8 mt-auto">
  <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-mono text-zinc-500">
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-2">
        <svg class="w-4 h-4 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        Certifa
      </span>
      <span class="text-zinc-700" aria-hidden="true">|</span>
      <span>offensive security</span>
      <span class="text-zinc-700" aria-hidden="true">|</span>
      <span>NL</span>
    </div>

    <div class="flex items-center gap-6">
      <span>© {year}</span>
      {links.map(({ href, label }) => (
        <a href={href} rel="me noopener" class="hover:text-zinc-300 transition-colors">{label}</a>
      ))}
    </div>
  </div>
</footer>
