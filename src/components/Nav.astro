---
// Transparent over the homepage hero, solid once you scroll past it. The
// `stuck` class is applied by script rather than by scroll position in CSS,
// because the homepage wants it to hold off for a whole viewport while every
// other page wants it solid immediately.
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/writeups', label: 'Writeups' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);

// Only the homepage has a full-bleed hero for the nav to float over.
const overHero = path === '/';
---

<nav class:list={['nav', { stuck: !overHero }]} id="nav" data-over-hero={overHero ? '' : null}>
  <a class="nav-mark" href="/">Certifa</a>

  <div class="nav-links">
    {links.map(({ href, label }) => (
      <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
    ))}
  </div>

  <a class="nav-out" href="https://github.com/Certifa" target="_blank" rel="noopener">GitHub</a>
</nav>

<script>
  const nav = document.getElementById('nav');
  if (nav) {
    // Over the hero it waits most of a viewport; elsewhere it is solid from the top.
    const overHero = nav.hasAttribute('data-over-hero');
    const trigger = overHero ? () => window.innerHeight * 0.72 : () => 40;
    const onScroll = () => nav.classList.toggle('stuck', window.scrollY > trigger());
    onScroll();
    addEventListener('scroll', onScroll, { passive: true });
  }
</script>
