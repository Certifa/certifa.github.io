---
// Shared site nav. Structure follows the export navs on Page_14 / Page_22 /
// Page_27, which all use real routes; Page_1's anchor-only nav was the outlier.
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/writeups', label: 'Writeups' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-bg/80 backdrop-blur-md border-b border-border">
  <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <div class="flex items-center gap-8">
      <a href="/" class="flex items-center gap-2 text-fg hover:text-accent transition-colors">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
        </svg>
        <span class="font-bold tracking-tight">Certifa</span>
      </a>

      <div class="hidden md:flex items-center gap-6 text-sm font-medium">
        {links.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isActive(href) ? 'page' : undefined}
            class:list={[
              'transition-colors',
              isActive(href) ? 'text-fg' : 'text-zinc-400 hover:text-fg',
            ]}
          >{label}</a>
        ))}
      </div>
    </div>

    <div class="flex items-center gap-3">
      <div class="hidden md:flex items-center gap-2 text-xs font-mono text-zinc-400 bg-surface border border-border px-3 py-1.5 rounded-full">
        <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
        Available
      </div>

      <a
        href="https://github.com/Certifa"
        rel="me noopener"
        class="hidden sm:flex text-sm font-medium text-zinc-300 border border-border hover:border-borderHover px-4 py-1.5 rounded-md transition-colors items-center gap-2"
      >
        GitHub
        <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>

      <button
        id="navToggle"
        type="button"
        class="md:hidden w-11 h-11 -mr-2 flex items-center justify-center text-zinc-400 hover:text-fg transition-colors"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="navDrawer"
      >
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"/>
        </svg>
      </button>
    </div>
  </div>

  <div id="navDrawer" class="md:hidden hidden border-t border-border bg-bg">
    <div class="px-6 py-3 flex flex-col">
      {links.map(({ href, label }) => (
        <a
          href={href}
          aria-current={isActive(href) ? 'page' : undefined}
          class:list={[
            'py-3 text-sm font-medium transition-colors',
            isActive(href) ? 'text-accent' : 'text-zinc-400 hover:text-fg',
          ]}
        >{label}</a>
      ))}
      <a href="https://github.com/Certifa" rel="me noopener" class="py-3 text-sm font-medium text-zinc-400 hover:text-fg transition-colors">GitHub</a>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('navToggle');
  const drawer = document.getElementById('navDrawer');

  toggle?.addEventListener('click', () => {
    const open = drawer?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
