---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="That page does not exist.">
  <section class="nf">
    <p class="eyebrow">/ 404</p>
    <h1 class="nf-code">404</h1>
    <p class="nf-sub">
      No route here. The page either moved, or it never existed and something
      linked to it anyway.
    </p>
    <div class="nf-links">
      <a href="/">Home</a>
      <a href="/writeups/">Writeups</a>
      <a href="/projects/">Projects</a>
      <a href="/contact/">Contact</a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .nf { position: relative; min-height: 78vh; display: flex; flex-direction: column;
    justify-content: center; padding: 22vh 4vw 12vh; }
  .nf::before { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse 52% 60% at 16% 46%, rgba(193,31,31,.09), transparent 70%); }
  .nf > * { position: relative; }
  .nf-code { margin: 0; font-family: var(--display); font-weight: 400;
    font-size: clamp(4rem, 18vw, 13rem); line-height: .82; color: var(--bone); }
  .nf-sub { margin: 3vh 0 0; max-width: 46ch; font-size: 1rem; line-height: 1.8; color: var(--read); }
  .nf-links { display: flex; gap: 1em; flex-wrap: wrap; margin-top: 5vh; }
  .nf-links a { font-size: .62rem; letter-spacing: .2em; text-transform: uppercase;
    color: var(--dim); text-decoration: none; border: 1px solid var(--line);
    padding: 1.1em 1.7em; transition: border-color .3s, color .3s; }
  .nf-links a:hover { border-color: var(--blood-lit); color: var(--bone); }
</style>
