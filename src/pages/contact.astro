---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';

const channels = [
  { label: 'mike@certifa.net', href: 'mailto:mike@certifa.net', primary: true, icon: 'mail' },
  { label: 'github/Certifa', href: 'https://github.com/Certifa', icon: 'github' },
  { label: 'hackthebox', href: 'https://app.hackthebox.com/users/Certifa', icon: 'htb' },
  { label: 'linkedin', href: 'https://www.linkedin.com/in/certifa', icon: 'linkedin' },
];
---

<BaseLayout
  title="Contact"
  description="CTF teams, internship leads, lab trades, or feedback on a writeup. Pick a channel, they all reach me."
>
  <div class="w-full max-w-6xl mx-auto px-6 py-16 md:py-24 flex items-center justify-center">
    <div class="w-full bg-surface border border-border rounded-3xl p-8 md:p-14 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center shadow-2xl">
      <!-- Left: copy and channels -->
      <div class="max-w-md">
        <h1 class="font-display text-4xl md:text-5xl font-bold text-white tracking-tight leading-[1.15] mb-6">
          Working on something<br />interesting?
        </h1>
        <p class="text-zinc-400 text-[15px] leading-relaxed mb-10">
          CTF teams, internship leads, lab trades, or feedback on a writeup.<br /><br />
          Pick a channel, they all reach me.
        </p>

        <div class="flex flex-wrap gap-3">
          {channels.map((c) => (
            <a
              href={c.href}
              rel="me noopener"
              class:list={[
                'touch-pill inline-flex items-center gap-2 px-4 py-2 border rounded-full text-sm font-mono transition-colors',
                c.primary
                  ? 'bg-surfaceHover border-borderHover text-white hover:border-zinc-500'
                  : 'bg-bg border-border text-zinc-400 hover:text-white hover:border-borderHover',
              ]}
            >
              {c.icon === 'mail' && (
                <svg class="w-4 h-4 text-zinc-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
              )}
              {c.icon === 'github' && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.5 2 2 6.6 2 12.3c0 4.5 2.9 8.3 6.8 9.7.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.4-3.4-1.4-.4-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5.1 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.7 1a9 9 0 0 1 5 0c1.9-1.3 2.7-1 2.7-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 4-2.4 4.8-4.6 5.1.4.3.7.9.7 1.9v2.8c0 .3.2.6.7.5 3.9-1.4 6.8-5.2 6.8-9.7C22 6.6 17.5 2 12 2z"/></svg>
              )}
              {c.icon === 'htb' && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2 3.5 7v10L12 22l8.5-5V7L12 2zm0 2.3 6.5 3.8-6.5 3.8-6.5-3.8L12 4.3zM5.5 9.6l5.5 3.2v6.5l-5.5-3.2V9.6zm7.5 9.7v-6.5l5.5-3.2v6.5l-5.5 3.2z"/></svg>
              )}
              {c.icon === 'linkedin' && (
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.75-1.95 4 0 4.4 2.5 4.4 5.8V21h-4v-5.6c0-1.35-.03-3.1-1.9-3.1-1.9 0-2.2 1.45-2.2 3v5.7H9z"/></svg>
              )}
              {c.label}
            </a>
          ))}

          <button
            type="button"
            data-copy="Quetro"
            class="touch-pill inline-flex items-center gap-2 px-4 py-2 bg-bg border border-border rounded-full text-sm font-mono text-zinc-400 hover:text-white hover:border-borderHover transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.3 5.3A16 16 0 0 0 15.2 4l-.2.4a15 15 0 0 1 3.6 1.3 12 12 0 0 0-9.2 0A15 15 0 0 1 13 4.4L12.8 4a16 16 0 0 0-4.1 1.3C5.9 9.5 5.2 13.6 5.5 17.6A16 16 0 0 0 10.4 20l.6-1a11 11 0 0 1-1.8-.9l.4-.3a11.5 11.5 0 0 0 9.8 0l.4.3a11 11 0 0 1-1.8.9l.6 1a16 16 0 0 0 4.9-2.4c.4-4.6-.7-8.7-3-12.3zM9.7 15.2c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2zm4.6 0c-1 0-1.8-.9-1.8-2s.8-2 1.8-2 1.8.9 1.8 2-.8 2-1.8 2z"/></svg>
            discord · Quetro
          </button>
        </div>
      </div>

      <!-- Right: form -->
      <div class="w-full max-w-lg lg:ml-auto">
        <ContactForm id="pageContact" variant="outlined" />
      </div>
    </div>
  </div>
</BaseLayout>
