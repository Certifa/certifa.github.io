    const [ctx, cols, rows] = surface(wm);
    if (!wmMask || wmW !== cols) { wmW = cols; wmMask = textMask(cols, rows, 'certifa', true); }
    const sweep = (t * 0.08) % 1.6 - 0.3;
    for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
      const a = wmMask.data[(y * cols + x) * 4 + 3] / 255; if (!a) continue;
      const val = a * (0.85 - (y / rows) * 0.6) + Math.max(0, 0.25 - Math.abs(x / cols - sweep) * 1.5);
      if (val > B[(y % 4) * 4 + (x % 4)]) ctx.fillRect(x * PX, y * PX, PX - 0.6, PX - 0.6);
    }
  }
  const seen = new Map();
  const vis = new IntersectionObserver(es => es.forEach(e => seen.set(e.target, e.isIntersecting)));
  vis.observe(mq); vis.observe(wm);
  document.fonts.ready.then(() => {
    marquee(0); wordmark(0);
    addEventListener('resize', () => { mqMask = wmMask = null; marquee(0); wordmark(0); });
    if (reduce) return;
    let last = 0;
    const loop = n => { if (!document.hidden && n - last > 70) { if (seen.get(mq)) marquee(n / 1000); if (seen.get(wm)) wordmark(n / 1000); last = n; } requestAnimationFrame(loop); };
    requestAnimationFrame(loop);
  });
})();
</script>
