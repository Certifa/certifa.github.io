.tt li.done::before{background:var(--accent);border-color:var(--accent)}
.tt li.cur{color:#eaeaea}
.tt li.cur::before{border-color:var(--accent)}
.tool .body{display:flex;flex-direction:column;gap:12px;padding:22px;flex:1}
.tool h3{font:500 20px var(--mono);letter-spacing:-.02em}
.tool .body>p{color:var(--muted);font-size:14.5px}
.tool ul{list-style:none;padding:0;display:grid;gap:7px;font-size:13.5px;color:#c4c4c4}
.tool li{display:grid;grid-template-columns:14px 1fr;gap:8px}
.tool li::before{content:"";width:6px;height:6px;margin-top:7px;border:1px solid #555}
.tool footer{margin-top:auto;padding-top:14px;border-top:1px solid #1c1c1c;display:flex;justify-content:space-between;align-items:center;font:400 11.5px var(--mono);color:#7c7c7c;text-transform:uppercase;letter-spacing:.04em}
.tool footer a{display:inline-flex;align-items:center;gap:5px;color:var(--accent);text-transform:none;letter-spacing:0;font:500 13px var(--sans)}
.tool footer a i{width:13px;height:13px}
.tool footer a:hover{color:#9bb8ff}

/* contact and footer, same as the other pages */
.contact{padding-top:90px;padding-bottom:120px;text-align:center}
.contact .label{justify-content:center}
.contact h2 a{border-bottom:1px solid #333}
.contact h2 a:hover{border-color:#e9e9e9}
.contact p{color:var(--muted);max-width:44ch;margin:18px auto 30px}
.contact nav{display:flex;flex-wrap:wrap;justify-content:center;gap:10px}
.logo{width:16px;height:16px;background:var(--c);-webkit-mask:var(--logo) center/contain no-repeat;mask:var(--logo) center/contain no-repeat}
.logo.li{background:#0a66c2;color:#fff;border-radius:3px;font:700 11px/16px Arial,sans-serif;text-align:center;-webkit-mask:none;mask:none}
.foot{border-top:1px solid var(--line);padding-top:40px;overflow:hidden}
#wordmark{display:block;width:100%;height:clamp(140px,22vw,320px)}
.foot-row{display:flex;justify-content:space-between;max-width:1200px;margin:0 auto;padding:18px 24px 28px;font-size:13px;color:var(--dim)}

@media (prefers-reduced-motion:reduce){
  .head h1,.ck{transition:none}
  .wirev .dot,.caret{animation:none!important}
  [data-at],.steps .d,.ledger li,.term>span,.tt>*{transition:none}
}
@media (max-width:900px){
  .nav ul{display:none}
  .sec{padding-left:24px;padding-right:24px}
  .story{height:auto}
  .stage{position:static;height:auto;grid-template-columns:1fr;gap:40px;padding:80px 0}
  .aegis-more{grid-template-columns:1fr;gap:32px}
  .ng-top,.ng-bottom{grid-template-columns:1fr;gap:28px}
  .ng-stage{grid-template-columns:1fr;row-gap:12px;padding:28px 18px 22px}
  .ng-grade{order:-1;margin-bottom:12px}
  .ck::after{display:none}
  .inner{grid-template-columns:1fr}
  .tools{grid-template-columns:1fr}
  .rest .top{flex-direction:column;align-items:start}
}
</style>

<script is:inline>
(() => {
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let lenis = null;

  // line icons
  const ICO = {
    shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    gauge: '<path d="M4 18a9 9 0 1 1 16 0"/><path d="m12 14 4-5"/>',
    terminal: '<path d="m4 17 6-6-6-6"/><path d="M12 19h8"/>',
    bot: '<rect x="4" y="8" width="16" height="12" rx="2"/><path d="M12 8V4M9 14h.01M15 14h.01"/>',
    file: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/><path d="M8 13h8M8 17h6"/>',
    link: '<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.5-1.5"/>',
    search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
    code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4"/>',
    arrow: '<path d="M7 17 17 7M8 7h9v9"/>',
    mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  };
  document.querySelectorAll('i[data-i]').forEach(el => { el.innerHTML = `<svg viewBox="0 0 24 24">${ICO[el.dataset.i] || ''}</svg>`; });

  // aegis story: the scroll position inside the pinned section picks the step, the console follows
  const story = document.getElementById('aegis'), stepsEl = document.getElementById('steps'), steps = [...stepsEl.children];
  const dot = document.getElementById('dot'), pay = document.querySelector('#policy [data-r="pay"]'), def = document.querySelector('#policy [data-r="default"]');
  const ledger = document.getElementById('ledger'), chain = document.getElementById('chain'), chainMsg = document.getElementById('chainMsg'), tamperBtn = document.getElementById('tamper');
  const N = 6, ROOM = 6.6; // the last step gets extra scroll, so there is time to try the tamper button
  const pinned = () => !reduce && !matchMedia('(max-width: 900px)').matches;
  let cur = -1;
  function setStep(n) {
    if (n === cur) return;
    const fwd = n > cur; cur = n;
    steps.forEach((li, i) => { li.classList.toggle('on', i === n); li.classList.toggle('past', i < n); });
    story.querySelectorAll('[data-at]').forEach(el => el.classList.toggle('in', n >= +el.dataset.at));
    pay.classList.toggle('miss', n >= 3); def.classList.toggle('hit-deny', n >= 3);
    if (n === 3 && fwd && !reduce) { dot.classList.remove('go'); void dot.offsetWidth; dot.classList.add('go'); }
    tamperBtn.tabIndex = n >= 5 ? 0 : -1;
    if (n < 5 && tampered) { tampered = false; renderLog(); }
  }
  function onScroll() {
    if (!pinned()) return;
    const r = story.getBoundingClientRect(), span = r.height - innerHeight;
    const f = Math.min(1, Math.max(0, -r.top / span)) * ROOM, n = Math.min(N - 1, Math.floor(f));
    setStep(n);
    steps[n].style.setProperty('--p', Math.min(1, n === N - 1 ? (f - n) / (ROOM - n) : f - n) * 100 + '%');
  }
  function layout() {
    stepsEl.classList.toggle('all', !pinned());
    if (pinned()) { cur = -1; onScroll(); } else setStep(N - 1);
  }
  addEventListener('scroll', onScroll, { passive: true });
  addEventListener('resize', layout);
  steps.forEach((li, i) => li.addEventListener('click', () => {
    if (!pinned()) return;
    const top = story.getBoundingClientRect().top + scrollY, y = top + (i + 0.5) / ROOM * (story.offsetHeight - innerHeight);
    lenis ? lenis.scrollTo(y) : scrollTo({ top: y, behavior: 'smooth' });
  }));

  // the provenance log: real SHA-256 over prev + record, so editing one record really breaks the links after it
  const LOG = [
    { seq: 141, v: 'deny', call: 'read_file("/secrets/db.env")' },
    { seq: 142, v: 'allow', call: 'make_payment(eur=40)' },
    { seq: 143, v: 'deny', call: 'make_payment(eur=5000)' },
    { seq: 144, v: 'allow', call: 'make_payment(eur=20)' },
    { seq: 145, v: 'deny', call: 'read_file("/secrets/api.key")' },
  ];
  const T = 2; // #143, the denied payment
  const fnv = s => { let h = 0x811c9dc5; for (const ch of s) { h ^= ch.charCodeAt(0); h = Math.imul(h, 0x01000193) >>> 0; } return h.toString(16).padStart(8, '0'); };
  const hash = async s => crypto.subtle
    ? [...new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(s)))].slice(0, 4).map(b => b.toString(16).padStart(2, '0')).join('')
    : fnv(s);
  const rec = (e, v = e.v) => `${e.seq}|${v}|${e.call}`;
  let tampered = false;
  async function sealLog() {
    let prev = await hash('genesis');
    for (const e of LOG) { e.prev = prev; e.hash = await hash(prev + rec(e)); prev = e.hash; }
  }
  async function renderLog() {
    const recomputed = tampered ? await hash(LOG[T].prev + rec(LOG[T], 'allow')) : null;
    ledger.innerHTML = LOG.map((e, i) => {
      const bad = tampered && i === T, dead = tampered && i > T;
      const v = bad ? `<span><span class="was">deny</span><span class="v allow">allow</span></span>` : `<span class="v ${e.v}">${e.v}</span>`;
      const flag = bad ? `hash mismatch, recomputed ${recomputed}` : dead ? (i === T + 1 ? `prev no longer matches #${LOG[T].seq}` : 'follows a dead link') : '';
      return `<li class="${bad ? 'bad' : dead ? 'dead' : ''}" data-at="4" style="transition-delay:${i * 90}ms"><span>#${e.seq}</span>${v}<span class="call">${e.call}</span><small>prev <b class="p">${e.prev}</b> &rarr; <b class="h">${e.hash}</b></small><em>${flag}</em></li>`;
    }).join('');
    ledger.querySelectorAll('li').forEach(li => li.classList.toggle('in', cur >= 4));
    chain.classList.toggle('broken', tampered);
    chainMsg.textContent = tampered ? `broken at #${LOG[T].seq}, ${LOG.length - T - 1} links dead` : `verified, ${LOG.length} of ${LOG.length} links`;
    tamperBtn.textContent = tampered ? `Restore #${LOG[T].seq}` : `Rewrite #${LOG[T].seq} as allow`;
    tamperBtn.classList.toggle('undo', tampered);
  }
  tamperBtn.addEventListener('click', () => {
    tampered = !tampered;
    renderLog().then(() => ledger.querySelectorAll('li').forEach(li => { li.style.transitionDelay = '0ms'; }));
  });
  sealLog().then(renderLog).then(layout);

  // dither helpers, same Bayer pattern as the rest of the site
  const B = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map(v => (v + 0.5) / 16), PX = 3;
  function surface(cv) {
    const dpr = devicePixelRatio || 1, w = cv.clientWidth, h = cv.clientHeight;
    if (cv.width !== w * dpr || cv.height !== h * dpr) { cv.width = w * dpr; cv.height = h * dpr; }
    const ctx = cv.getContext('2d'); ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, w, h); ctx.fillStyle = '#9a9a9a';
    return [ctx, Math.ceil(w / PX), Math.ceil(h / PX)];
  }
  function textMask(cols, rows, text, size, y) {
    const off = document.createElement('canvas'); off.width = cols; off.height = rows;
    const o = off.getContext('2d'); o.font = `600 ${size}px Geist, sans-serif`; o.fillStyle = '#fff'; o.textAlign = 'center';
    o.fillText(text, cols / 2, y);
    return o.getImageData(0, 0, cols, rows).data;
  }

  // netgrade: the checks run one by one and feed the grade; the one with no answer never reaches it
  const checks = [...document.querySelectorAll('#scan .ck')], gradeCv = document.getElementById('grade'), scoreEl = document.getElementById('score');
  const LBL = { pass: 'pass', warn: 'warn', none: 'excluded' };
  checks.forEach(li => li.insertAdjacentHTML('beforeend', `<span class="v ${li.dataset.v}">${LBL[li.dataset.v]}</span>`));
  let gMask = null, gLevel = 0;
  function grade(level) {
    gLevel = level;
    if (!gradeCv.clientWidth || !gradeCv.clientHeight) return;
    const [ctx, cols, rows] = surface(gradeCv);
    if (!gMask) gMask = textMask(cols, rows, 'A', rows * 1.15, rows * 0.93);
    for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
      const a = gMask[(y * cols + x) * 4 + 3] / 255; if (!a) continue;
      if (a * level * (1 - (y / rows) * 0.45) > B[(y % 4) * 4 + (x % 4)]) ctx.fillRect(x * PX, y * PX, PX - 0.6, PX - 0.6);
    }
  }
  function ramp(from, to, ms, each) {
    return new Promise(done => {
      const t0 = performance.now();
      const f = now => { const p = Math.min(1, (now - t0) / ms), e = 1 - (1 - p) ** 3; each(from + (to - from) * e); p < 1 ? requestAnimationFrame(f) : done(); };
      requestAnimationFrame(f);
    });
  }
  const wait = ms => new Promise(r => setTimeout(r, ms));
  let scanning = false;
  async function scan() {
    if (scanning) return; scanning = true;
    checks.forEach(li => li.classList.remove('on', 'cur'));
    scoreEl.textContent = '0'; grade(0);
    let lvl = 0;
    for (const li of checks) {
      checks.forEach(c => c.classList.remove('cur'));
      li.classList.add('on', 'cur');
      if (li.dataset.v !== 'none') { const to = lvl + 0.07; await ramp(lvl, to, 300, grade); lvl = to; } else await wait(300);
      await wait(120);
    }
    checks.forEach(c => c.classList.remove('cur'));
    await ramp(lvl, 1, 1100, v => { grade(v); scoreEl.textContent = Math.round(98 * (v - lvl) / (1 - lvl)); });
    scanning = false;
  }
  document.getElementById('rescan').addEventListener('click', scan);
  document.fonts.ready.then(() => {
    if (reduce) { checks.forEach(li => li.classList.add('on')); grade(1); scoreEl.textContent = '98'; return; }
    grade(0);
    let ran = false;
    new IntersectionObserver(([e]) => { if (e.isIntersecting && !ran) { ran = true; scan(); } }, { threshold: 0.4 }).observe(document.getElementById('scan'));
  });

  // one heading types itself in once
  document.querySelectorAll('h2.type').forEach(h => {
    if (reduce) return;
    const text = h.textContent;
    h.classList.add('typed');
    h.innerHTML = `<span></span><span class="tcaret"></span><span class="ghost">${text}</span>`;
    const done = h.firstChild, ghost = h.lastChild;
    const o = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return; o.disconnect();
      let i = 0; const t = setInterval(() => { i++; done.textContent = text.slice(0, i); ghost.textContent = text.slice(i); if (i >= text.length) { clearInterval(t); setTimeout(() => h.querySelector('.tcaret').remove(), 900); } }, 34);
    }, { threshold: 0.8 });
    o.observe(h);
  });

  // tool cards: the screen reveals line by line when it scrolls in, and replays on hover
  document.querySelectorAll('.tool .term, .tool .tt').forEach(scr => {
    const lines = [...scr.children];
    if (reduce) { lines.forEach(l => l.classList.add('in')); return; }
    const show = () => lines.forEach((l, i) => { l.classList.remove('in'); setTimeout(() => l.classList.add('in'), i * 150); });
    let seen = false;
    new IntersectionObserver(([e]) => { if (e.isIntersecting && !seen) { seen = true; show(); } }, { threshold: 0.4 }).observe(scr);
    scr.closest('.tool').addEventListener('mouseenter', () => { if (seen) show(); });
  });

  // reading progress
  const bar = document.getElementById('progress');
  const prog = () => { const max = document.documentElement.scrollHeight - innerHeight; bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`; };
  addEventListener('scroll', prog, { passive: true }); prog();

  // header marquee and footer wordmark, both in dither
  const mq = document.getElementById('marquee'), wm = document.getElementById('wordmark');
  const NAMES = 'AEGIS   NETGRADE   HTB-TRACKER   NMAPFULLSCAN   SHELLFORGE   ';
  let mqMask = null, mqW = 0, wmMask = null, wmW = 0;
  function wideMask(rows, text) {
    const o = document.createElement('canvas').getContext('2d'), size = rows * 0.95;
    o.font = `600 ${size}px Geist, sans-serif`;
    const w = Math.ceil(o.measureText(text).width), off = document.createElement('canvas'); off.width = w; off.height = rows;
    const c = off.getContext('2d'); c.font = `600 ${size}px Geist, sans-serif`; c.fillStyle = '#fff'; c.fillText(text, 0, rows * 0.86);
    return { data: c.getImageData(0, 0, w, rows).data, w };
  }
  function marquee(t) {
    if (!mq.clientWidth || !mq.clientHeight) return;
    const [ctx, cols, rows] = surface(mq);
    if (!mqMask || mqW !== cols) { mqW = cols; mqMask = wideMask(rows, NAMES); }
    const shift = Math.floor(t * 6) % mqMask.w;
    for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
      const a = mqMask.data[(y * mqMask.w + (x + shift) % mqMask.w) * 4 + 3] / 255; if (!a) continue;
      const edge = Math.min(1, Math.min(x, cols - x) / (cols * 0.18));
      if (a * 0.6 * edge > B[(y % 4) * 4 + (x % 4)]) ctx.fillRect(x * PX, y * PX, PX - 0.6, PX - 0.6);
    }
  }
  function wordmark(t) {
    if (!wm.clientWidth || !wm.clientHeight) return;
    const [ctx, cols, rows] = surface(wm);
    if (!wmMask || wmW !== cols) {
      wmW = cols; const o = document.createElement('canvas').getContext('2d');
      o.font = `600 ${rows}px Geist, sans-serif`;
      wmMask = textMask(cols, rows, 'certifa', rows * (cols * 0.96) / o.measureText('certifa').width, rows * 0.86);
    }
    const sweep = (t * 0.08) % 1.6 - 0.3;
    for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
      const a = wmMask[(y * cols + x) * 4 + 3] / 255; if (!a) continue;
      const val = a * (0.85 - (y / rows) * 0.6) + Math.max(0, 0.25 - Math.abs(x / cols - sweep) * 1.5);
      if (val > B[(y % 4) * 4 + (x % 4)]) ctx.fillRect(x * PX, y * PX, PX - 0.6, PX - 0.6);
    }
  }
  document.fonts.ready.then(() => {
    marquee(0); wordmark(0);
    addEventListener('resize', () => { mqMask = wmMask = gMask = null; marquee(0); wordmark(0); grade(gLevel); });
    if (reduce) return;
    const seen = new Map(), io = new IntersectionObserver(es => es.forEach(e => seen.set(e.target, e.isIntersecting)));
    io.observe(mq); io.observe(wm);
    let last = 0;
    const loop = n => { if (!document.hidden && n - last > 70) { if (seen.get(mq)) marquee(n / 1000); if (seen.get(wm)) wordmark(n / 1000); last = n; } requestAnimationFrame(loop); };
    requestAnimationFrame(loop);
  });
})();
</script>
