---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Project {
  name: string;
  category: 'Active Directory' | 'Web' | 'Infrastructure';
  desc: string;
  link?: string;
}

const projects: Project[] = [
  {
    name: 'HackTheBox Profile',
    category: 'Active Directory',
    desc: '50+ machines across Easy → Insane. Master rank, peak Pro Hacker. The main proving ground for Active Directory, Linux/Windows privesc, and web exploitation.',
    link: 'https://profile.hackthebox.com/profile/019c2f48-7b5d-73a8-b798-3ee811960672',
  },
  {
    name: 'HTB Tracker',
    category: 'Web',
    desc: 'Personal web dashboard tracking completed HTB machines: difficulty breakdown, platform stats, progress telemetry. Vanilla JS + GitHub Pages.',
    link: 'https://certifa.github.io/htb-tracker/',
  },
  {
    name: 'Active Directory Homelab',
    category: 'Active Directory',
    desc: 'Windows Server 2022 DC with two workstations. Used to rebuild chains locally: Kerberos abuse, BloodHound enumeration, NTLM relay, and AD misconfig chains.',
  },
  {
    name: 'HTB Recon Automation',
    category: 'Infrastructure',
    desc: 'Python orchestrator: nmap fingerprinting → parsed services → ffuf/gobuster with tuned wordlists → single report template. Saves an hour on every box.',
    link: 'https://github.com/Certifa',
  },
  {
    name: 'This Portfolio',
    category: 'Web',
    desc: 'Built with Astro + Tailwind CSS. Content collections drive the writeups; GitHub Actions deploys to Pages.',
    link: 'https://github.com/Certifa/certifa.github.io',
  },
];

const CARD =
  'group relative flex flex-col p-6 border border-border bg-surface/40 hover:bg-surface hover:border-accent/40 rounded-xl transition-all duration-300 h-full';
---

<BaseLayout
  title="Projects"
  description="Personal labs, automation, and tooling that support my offensive workflow."
  effects
>
  <div class="pt-16 pb-24 relative isolate">
    <div
      class="absolute inset-x-0 top-0 h-[500px] -z-10 pointer-events-none"
      style="mask-image: linear-gradient(to bottom, black 0%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 100%);"
    >
      <div
        data-aifx="ascii"
        data-aifx-colors="#09090b,#0d1410,#142419,#1e3b26"
        data-aifx-bg="#09090b"
        data-aifx-speed="0.2"
        data-aifx-scale="1.2"
        data-aifx-glow="0.2"
        class="w-full h-full opacity-70"
        aria-hidden="true"
      ></div>
    </div>

    <div class="max-w-5xl mx-auto px-6">
      <header class="mb-16">
        <div class="font-mono text-xs tracking-wider text-muted uppercase mb-4 flex items-center gap-2">
          <span class="text-accent">/</span> PROJECTS
        </div>
        <h1 class="font-display text-4xl md:text-5xl font-bold text-fg tracking-tight mb-6">
          Projects
        </h1>
        <p class="text-lg text-zinc-400 max-w-2xl leading-relaxed">
          Personal labs, automation, and tooling that support my offensive workflow.
        </p>
      </header>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {projects.map((p) => {
          const Tag = p.link ? 'a' : 'div';
          return (
            <Tag
              class={CARD}
              {...(p.link ? { href: p.link, rel: 'noopener' } : {})}
            >
              <div class="flex justify-between items-start mb-4 gap-4">
                <h3 class="text-lg font-semibold text-fg group-hover:text-accent transition-colors">{p.name}</h3>
                <span class="px-2.5 py-1 text-[10px] font-mono text-accent border border-accent/30 bg-accent/5 rounded-md shrink-0">{p.category}</span>
              </div>
              <p class="text-zinc-400 text-sm leading-relaxed mt-auto">{p.desc}</p>
            </Tag>
          );
        })}
      </div>

      <div class="mt-16 flex justify-center">
        <a
          href="https://github.com/Certifa"
          rel="me noopener"
          class="px-6 py-2.5 text-sm font-medium text-zinc-400 border border-border rounded-lg hover:border-accent hover:text-accent transition-colors"
        >
          More on GitHub
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
