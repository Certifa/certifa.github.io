.rescan:focus-visible{outline:2px solid #fff;outline-offset:2px}
.rescan i[data-i]{width:13px;height:13px}
.ng-cap{grid-column:1/-1;margin-top:30px;text-align:center;font:400 11.5px var(--mono);color:#6f6f6f;text-transform:uppercase;letter-spacing:.06em}
.ng-bottom{display:grid;grid-template-columns:1fr 1fr;gap:56px;margin-top:56px}
