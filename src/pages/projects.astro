.term .cmd{color:#eaeaea}
.term .cmd::before{content:"$ ";color:var(--accent)}
.term .hd{color:#7aa2ff;margin-top:5px}
.term .out{color:#9a9a9a}
.term .out b{font-weight:400;color:#e6e6e6}
.term .ok{color:#3ecf8e;margin-top:5px}
.term .mut{color:#6f6f6f}
