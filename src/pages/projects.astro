.tt .tabs .on{color:#c9d6ff;border-color:#3a4a7a;background:#171a24}
.tt ul{list-style:none;padding:0;margin:0;display:grid;gap:7px}
.tt li{display:grid;grid-template-columns:14px 1fr;gap:9px;align-items:center;font-size:12.5px;color:#8a8a8a}
