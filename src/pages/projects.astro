.tamper:focus-visible{outline:2px solid #fff;outline-offset:2px}
.tamper.undo{background:#161616;border-color:#333}

@media (max-height:820px) and (min-width:901px){.stage .btag,.stage .agent .row,.gate pre .c{display:none}.stage .doc{margin:6px 12px 8px;padding:8px 10px}.wirev{height:30px}.ledger li{padding:5px 8px}.steps li{padding:10px 0}}

/* the rest of the aegis text, after the story */
.aegis-more{display:grid;grid-template-columns:1fr 1fr;gap:56px;padding-top:80px;padding-bottom:110px}
.aegis-more .pull{margin-top:0}
.v{font:500 10.5px/1 var(--mono);padding:4px 7px;border-radius:5px;text-transform:uppercase}
.v.allow,.v.pass{color:#3ecf8e;background:rgba(62,207,142,.12)}
.v.deny{color:#ff6b6b;background:rgba(255,92,92,.12)}
.v.warn{color:#fbbf24;background:rgba(251,191,36,.12)}
.v.none{color:#9a9a9a;background:#1c1c1c}
.cap{font-size:12.5px;color:var(--dim);margin:12px 4px 0}

/* netgrade: the grade in the middle, seven checks wired into it */
.ng{padding-top:90px;padding-bottom:110px;scroll-margin-top:20px}
.ng-top{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:end}
.ng-top .pull{margin:24px 0 0}
.ng-top .desc{margin:0}
.ng-stage{position:relative;margin-top:56px;display:grid;grid-template-columns:1fr 280px 1fr;column-gap:72px;align-items:center;padding:44px 32px 28px;border:1px solid var(--line);border-radius:18px;
  background:#0d0d0d radial-gradient(#1c1c1c 1px,transparent 1px) 0 0/16px 16px}
.cks{list-style:none;padding:0;margin:0;display:grid;gap:12px}
.ck{position:relative;display:grid;grid-template-columns:1fr auto;gap:2px 12px;align-items:center;padding:11px 14px;border:1px solid #242424;border-radius:11px;background:#121212;opacity:.3;transition:opacity .35s,border-color .35s}
.ck b{font-weight:500;font-size:14px}
.ck em{grid-column:1;font:400 11.5px var(--mono);font-style:normal;color:#7c7c7c}
.ck em:empty{display:none}
.ck .v{grid-row:1/3;grid-column:2;min-width:74px;text-align:center}
.ck:not(.on) .v{visibility:hidden}
.ck.on{opacity:1}
.ck.cur{border-color:#3a4a7a}
.ck::after{content:"";position:absolute;top:50%;width:92px;border-top:1px solid #262626;transition:border-color .35s}
.cks.l .ck::after{left:100%}
.cks.r .ck::after{right:100%}
.ck.on[data-v=pass]::after{border-color:rgba(62,207,142,.55)}
.ck.on[data-v=warn]::after{border-color:rgba(251,191,36,.6)}
.ck[data-v=none]::after{border-top-style:dashed;width:44px}
.ck.on[data-v=none]::after{border-color:#555}
.ng-grade{text-align:center}
.ng-grade>small{font:400 11.5px var(--mono);color:var(--dim);text-transform:uppercase;letter-spacing:.06em}
#grade{display:block;width:240px;height:240px;margin:8px auto 4px}
.score{font:600 44px/1 var(--sans);letter-spacing:-.03em}
.score span{font:400 16px var(--mono);color:var(--dim);margin-left:4px}
.gradelbl{font:400 12px var(--mono);color:var(--dim);text-transform:uppercase;letter-spacing:.04em;margin-top:8px}
