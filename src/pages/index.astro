const clock = new THREE.Timer();
(function tick(){
  requestAnimationFrame(tick);
  clock.update();
  const dt=clock.getDelta(), t=clock.getElapsed();
  room.rotation.y = Math.sin(t*.05)*.010;
  room.rotation.x = Math.cos(t*.04)*.006;
  const dp = dGeo.attributes.position.array;
  for(let i=0;i<DUST;i++){
    dp[i*3+1] += dt*.085*(0.4+(i%7)/7);
    dp[i*3]   += Math.sin(t*.2+i)*dt*.028;
    if (dp[i*3+1] > 7.5) dp[i*3+1] = -7.5;
  }
  dGeo.attributes.position.needsUpdate = true;
  if (heroVisible){ drawScreen(); renderer.render(scene,camera); }
})();

const intro = gsap.timeline({delay:.15});
intro.to('#kicker',{opacity:1,duration:.3},0);
gsap.utils.toArray('.strike .i').forEach((ln,i)=>{
  intro.to(ln,{y:'0%',duration:.2,ease:'power4.out'}, .14+i*.17)
       .fromTo(ln,{x:-8},{x:0,duration:.16,ease:'power3.out'}, .14+i*.17+.13);
});
intro.to('#slash',{scaleX:1,duration:.26,ease:'power4.inOut'},.5)
     .to('#whoami',{opacity:1,duration:.5},.66);

/* Hold the replay until the desk actually exists, otherwise the chain is
   already half-typed by the time anything is on screen. */
let started = false;
function begin(){
  if (started) return;
  started = true;
  bStage.textContent = 'Ready';
  bFill.style.transform = 'scaleX(1)';
  bPct.textContent = '100%';
  gsap.to(bootEl, {opacity:0, duration:.55, ease:'power2.inOut',
    onComplete: () => {
      bootEl.remove();
      // ScrollTrigger measured the page while the boot screen was still in the
      // layout, so every trigger point below the fold was wrong until now
      ScrollTrigger.refresh();
    }});

  if (!reduced) runReplay();
  else {
    powered = 1;
    SCRIPT.forEach(s => shown.push({t:s.t, c:s.c, chars:s.t.length, redacted:s.redacted}));
    statusWho='administrator @ DARKZERO.HTB'; statusPriv='domain admin'; statusLvl=3;
    setHeat(1);
  }
}


