---
import { existsSync } from 'node:fs';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WriteupFeature from '../components/WriteupFeature.astro';
import ContactForm from '../components/ContactForm.astro';

// The export hardcoded three invented writeups. These come from the content
// collection: featured entries, newest first, top three.
const featured = (await getCollection('writeups'))
  .filter((w) => w.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Real box art, the same source the writeups listing uses. The export's stock
// photography was cycled by position, so a given photo stood for whichever box
// happened to land in that slot. Resolved at build; a box without an avatar
// falls back to the code motif rather than 404ing.
const avatarFor = (slug: string) => {
  const box = slug.replace(/^htb-/, '');
  return existsSync(`public/og-avatars/${box}.png`) ? `/og-avatars/${box}.png` : null;
};

// The section is called Security Arsenal but never showed an actual tool. Every
// entry here appears in a published writeup or on the about page: nothing
// aspirational. Rendered with the tool-pill treatment from Page_14's sidebar.
const toolkit = [
  { label: 'Recon', tools: ['nmap', 'ffuf', 'gobuster'] },
  { label: 'Active Directory', tools: ['BloodHound', 'impacket', 'Rubeus', 'crackmapexec'] },
  { label: 'Creds & post-ex', tools: ['hashcat', 'Responder', 'evil-winrm'] },
];

// Read as a roadmap, not a trophy shelf: none of these are held yet, which the
// card says outright. `current` marks the one with a date attached.
const certs = [
  { name: 'CJCA', issuer: 'HackTheBox', status: 'EXAM BOOKED', current: true },
  { name: 'CPTS', issuer: 'HackTheBox', status: 'NEXT', current: false },
  { name: 'CCNA', issuer: 'Cisco', status: 'PLANNED', current: false },
];
---

<BaseLayout
  title="Certifa"
  description="Offensive security student. I take apart Active Directory environments, web applications, and Linux boxes, then write down exactly how."
  effects
>
  <!-- Export used pt-32/pt-48 measured from the top of the page; main already
       clears the 4rem nav, so these are the remainder. -->
  <div class="w-full pt-16 md:pt-32 pb-24">
    <!-- ================= HERO ================= -->
    <section class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 lg:grid-cols-2 gap-16 items-start relative isolate mb-32">
      <!-- WebGL ASCII field from the export, driven by the AIDesigner runtime
           loaded at the bottom of this page. -->
      <div
        data-aifx="ascii"
        data-aifx-colors="#030805,#081a10,#103820,#4ade80"
        data-aifx-bg="#09090b"
        data-aifx-bg-alpha="0"
        data-aifx-speed="0.25"
        data-aifx-scale="1.2"
        data-aifx-glow="0.6"
        class="hero-field absolute inset-[0_0_10%_0] -z-10 pointer-events-none opacity-70 [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_80%)]"
        aria-hidden="true"
      ></div>

      <!-- Left: typography & CTAs -->
      <div class="hero-copy flex flex-col items-start text-left z-10 lg:sticky lg:top-32">
        <div class="flex items-center gap-3 mb-8">
          <span class="font-mono text-[10px] text-zinc-400 uppercase tracking-widest">
            OFFENSIVE SECURITY STUDENT <span class="text-accent font-bold">_</span>
          </span>
        </div>

        <h1 class="font-display text-5xl md:text-6xl lg:text-[4rem] font-bold tracking-tight leading-[1.05] text-white mb-8">
          Break systems.<br />
          <span class="text-accent">Document truth.</span>
        </h1>

        <p class="font-mono text-[13px] text-zinc-300 max-w-[28rem] leading-relaxed mb-12">
          I break Active Directory, Linux, and web targets on HackTheBox, then write down exactly how. Looking for my first red-team seat.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto">
          <a href="#logs" class="w-full sm:w-auto px-8 py-3 rounded-[3px] border border-border bg-surface text-white font-mono text-[10px] uppercase tracking-widest hover:bg-surfaceHover hover:border-borderHover transition-colors flex items-center justify-center text-center">
            VIEW WRITEUPS
          </a>
          <a href="#infrastructure" class="w-full sm:w-auto px-8 py-3 rounded-[3px] border border-border bg-surface text-white font-mono text-[10px] uppercase tracking-widest hover:bg-surfaceHover hover:border-borderHover transition-colors flex items-center justify-center text-center">
            VIEW ARSENAL
          </a>
        </div>
      </div>

      <!-- Right: static attack-path graph. The box it charts is retired, so the
           panel links to its writeup: see "The hero graph must show a retired
           box" in CLAUDE.md before swapping in another machine. -->
      <div class="flex flex-col w-full z-10">
        <a
          href="/writeups/htb-darkzero/"
          aria-label="DarkZero writeup"
          class="group relative block w-full rounded-lg overflow-hidden border border-accent/30 bg-surface/90 backdrop-blur p-6 lg:p-8 shadow-[0_0_50px_rgba(74,222,128,0.08)] hover:border-accent/60 hover:shadow-[0_0_60px_rgba(74,222,128,0.14)] transition-all duration-500"
        >
          <div class="relative z-20 flex items-start justify-between gap-4 mb-4">
            <span class="font-mono text-[9px] text-zinc-400 group-hover:text-white uppercase tracking-widest transition-colors flex items-center gap-2">
              DarkZero · HTB · Hard
              <svg class="w-3 h-3 text-accent opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </span>
            <div class="hidden sm:flex flex-col gap-3 font-mono text-[9px] text-muted shrink-0">
              <div class="flex items-center gap-3">
                <span class="w-6 h-[1.5px] bg-accent"></span> Foothold Chain
              </div>
              <div class="flex items-center gap-3">
                <span class="w-6 border-t border-dashed border-zinc-600"></span> Objectives
              </div>
            </div>
          </div>

          <div class="relative z-20 w-full flex items-center justify-center">
            <svg viewBox="0 0 400 560" class="w-full h-auto attack-graph" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="DarkZero attack path: domain credentials into MSSQL, a linked-server hop to the second domain, xp_cmdshell for execution as the SQL service account, CVE-2024-30088 for SYSTEM on DC02, then user.txt on one branch and, on the other, Rubeus with PetitPotam capturing the DC01 ticket, a Golden Ticket forged from the krbtgt key, and root.txt.">
              <defs>
                <marker id="arrow-accent" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse">
                  <path d="M 0 0 L 10 5 L 0 10 z" class="arrow-primary" />
                </marker>
                <marker id="arrow-gray" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse">
                  <path d="M 0 0 L 10 5 L 0 10 z" class="arrow-secondary" />
                </marker>
                <pattern id="dotGrid" width="20" height="20" patternUnits="userSpaceOnUse">
                  <circle cx="2" cy="2" r="1" class="grid-dot" />
                </pattern>
              </defs>

              <rect width="100%" height="100%" fill="url(#dotGrid)" />

              <!-- Primary path -->
              <path d="M 200 45 L 200 60" class="edge-primary" marker-end="url(#arrow-accent)" />
              <path d="M 200 95 L 200 110" class="edge-primary" marker-end="url(#arrow-accent)" />
              <path d="M 200 145 L 200 160" class="edge-primary" marker-end="url(#arrow-accent)" />
              <path d="M 200 195 L 200 210" class="edge-primary" marker-end="url(#arrow-accent)" />
              <path d="M 200 245 L 200 260" class="edge-primary" marker-end="url(#arrow-accent)" />
              <path d="M 200 305 L 200 320" class="edge-primary" marker-end="url(#arrow-accent)" />

              <!-- Secondary paths -->
              <path d="M 200 355 L 200 370 L 100 370 L 100 380" class="edge-secondary" marker-end="url(#arrow-gray)" />
              <path d="M 200 355 L 200 370 L 255 370 L 255 380" class="edge-secondary" marker-end="url(#arrow-gray)" />
              <path d="M 255 415 L 255 440" class="edge-secondary" marker-end="url(#arrow-gray)" />
              <path d="M 255 475 L 255 490 L 200 490 L 200 500" class="edge-secondary" marker-end="url(#arrow-gray)" />
              <path d="M 100 415 L 100 490 L 200 490" class="edge-secondary" />

              <rect x="120" y="15" width="160" height="30" class="node-rect" />
              <text x="200" y="31" class="node-text">john.w · domain creds</text>
              <circle cx="100" cy="30" r="8" class="node-num-circle" />
              <text x="100" y="31" class="node-num">1</text>

              <rect x="120" y="65" width="160" height="30" class="node-rect" />
              <text x="200" y="81" class="node-text">MSSQL 1433 · DC01</text>
              <circle cx="100" cy="80" r="8" class="node-num-circle" />
              <text x="100" y="81" class="node-num">2</text>

              <rect x="120" y="115" width="160" height="30" class="node-rect" />
              <text x="200" y="131" class="node-text">use_link → DC02.ext</text>
              <circle cx="100" cy="130" r="8" class="node-num-circle" />
              <text x="100" y="131" class="node-num">3</text>

              <rect x="120" y="165" width="160" height="30" class="node-rect" />
              <text x="200" y="181" class="node-text">xp_cmdshell → RCE</text>
              <circle cx="100" cy="180" r="8" class="node-num-circle" />
              <text x="100" y="181" class="node-num">4</text>

              <rect x="120" y="215" width="160" height="30" class="node-rect" />
              <text x="200" y="231" class="node-text">Meterpreter · svc_sql</text>
              <circle cx="100" cy="230" r="8" class="node-num-circle" />
              <text x="100" y="231" class="node-num">5</text>

              <rect x="120" y="265" width="160" height="40" class="node-rect" />
              <text x="200" y="280" class="node-text">winPEAS → CVE-2024-30088</text>
              <text x="200" y="294" class="node-text">kernel LPE</text>
              <circle cx="100" cy="285" r="8" class="node-num-circle" />
              <text x="100" y="286" class="node-num">6</text>

              <rect x="120" y="325" width="160" height="30" class="node-rect" />
              <text x="200" y="341" class="node-text">SYSTEM on DC02</text>
              <circle cx="100" cy="340" r="8" class="node-num-circle" />
              <text x="100" y="341" class="node-num">7</text>

              <rect x="50" y="385" width="100" height="30" class="node-rect" />
              <text x="100" y="401" class="node-text">user.txt</text>
              <circle cx="30" cy="400" r="8" class="node-num-circle" />
              <text x="30" y="401" class="node-num">8</text>

              <rect x="180" y="385" width="150" height="40" class="node-rect" />
              <text x="255" y="400" class="node-text">Rubeus + PetitPotam</text>
              <text x="255" y="414" class="node-text">→ DC01 TGT</text>
              <circle cx="160" cy="405" r="8" class="node-num-circle" />
              <text x="160" y="406" class="node-num">8</text>

              <rect x="180" y="445" width="150" height="30" class="node-rect" />
              <text x="255" y="461" class="node-text">krbtgt → Golden Ticket</text>
              <circle cx="160" cy="460" r="8" class="node-num-circle" />
              <text x="160" y="461" class="node-num">9</text>

              <rect x="120" y="505" width="160" height="30" class="node-rect-accent" />
              <text x="200" y="521" class="node-text-accent">root.txt</text>
              <circle cx="100" cy="520" r="8" class="node-num-circle" />
              <text x="100" y="521" class="node-num">10</text>
            </svg>
          </div>
        </a>
      </div>
    </section>

    <!-- Divider -->
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="w-full h-px bg-gradient-to-r from-border to-transparent mb-24"></div>
    </div>

    <!-- ================= WRITEUPS ================= -->
    <section id="logs" class="max-w-7xl mx-auto px-6 md:px-12 mb-40">
      <div class="flex items-center gap-4 mb-16" data-reveal>
        <div class="w-1 h-6 bg-accent"></div>
        <h2 class="text-2xl font-mono tracking-tight text-white">Threat Intelligence Logs</h2>
      </div>

      <div class="flex flex-col gap-24">
        {featured.map((w, i) => (
          <WriteupFeature
            slug={w.slug}
            title={w.data.title}
            description={w.data.description}
            tags={w.data.tags}
            difficulty={w.data.difficulty}
            platform={w.data.platform}
            kicker={i === 0 ? 'RECENT' : 'ARCHIVE'}
            flip={i % 2 === 1}
            avatar={avatarFor(w.slug)}
          />
        ))}
      </div>

      <div class="mt-20 flex justify-center" data-reveal>
        <a href="/writeups" class="px-8 py-3 rounded-[3px] border border-border font-mono text-[10px] uppercase tracking-widest text-white hover:bg-white/5 hover:border-borderHover flex items-center gap-2 transition-all">
          All writeups
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>

    <!-- ================= ARSENAL ================= -->
    <section id="infrastructure" class="max-w-7xl mx-auto px-6 md:px-12 mb-40">
      <div class="mb-12" data-reveal>
        <h2 class="font-display text-3xl font-semibold tracking-tighter text-white mb-2">Security Arsenal</h2>
        <p class="text-muted">The tools I reach for, the lab I run them against, and what's next on the list.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Tooling -->
        <div class="spotlight-card group md:col-span-2 h-auto md:h-[400px]" data-reveal>
          <div class="spotlight-content p-8 flex flex-col justify-between overflow-hidden relative">
            <div class="absolute inset-0 bg-gradient-to-br from-white/[0.03] to-transparent pointer-events-none"></div>
            <div class="scan-line hidden md:block"></div>

            <div class="relative z-10">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center text-accent border border-accent/20">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17l6-6-6-6M12 19h8"/></svg>
                </div>
                <h3 class="font-medium text-white">Custom Tooling &amp; Automation</h3>
              </div>
              <p class="text-muted text-sm max-w-md">
                A Python orchestrator that chains recon on every box: nmap fingerprints the services, the parsed results pick the wordlists, and ffuf and gobuster fill in one report template.
              </p>
            </div>

            <div class="relative z-10 w-full bg-[#0d0d0f] border border-border rounded-lg mt-6 p-4 shadow-2xl transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
              <div class="flex items-center gap-2 mb-4 border-b border-border pb-3">
                <span class="w-1.5 h-1.5 rounded-full bg-accent/60"></span>
                <span class="font-mono text-[10px] text-muted uppercase tracking-widest">recon.py</span>
              </div>
              <pre class="font-mono text-xs leading-relaxed overflow-x-auto text-zinc-400"><code><span class="text-purple-400">def</span> <span class="text-blue-400">enumerate</span>(target):
    services = <span class="text-blue-400">nmap</span>(target, <span class="text-teal-400">flags</span>=<span class="text-green-400">"-sC -sV"</span>)

    <span class="text-purple-400">for</span> svc <span class="text-purple-400">in</span> services:
        <span class="text-purple-400">if</span> svc.name <span class="text-purple-400">in</span> (<span class="text-green-400">"http"</span>, <span class="text-green-400">"https"</span>):
            <span class="text-blue-400">ffuf</span>(svc, wordlist=<span class="text-blue-400">pick</span>(svc))

    <span class="text-purple-400">return</span> <span class="text-blue-400">report</span>(target, services)</code></pre>
            </div>
          </div>
        </div>

        <!-- Certifications -->
        <div class="spotlight-card md:col-span-1 h-auto md:h-[400px]" data-reveal data-reveal-delay="1">
          <div class="spotlight-content p-8 flex flex-col relative overflow-hidden">
            <div class="absolute top-0 right-0 w-48 h-48 bg-accent/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>

            <div class="flex items-center gap-3 mb-2">
              <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-white border border-border">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="M8.5 14.5L7 22l5-3 5 3-1.5-7.5"/></svg>
              </div>
              <h3 class="font-medium text-white">Certification Roadmap</h3>
            </div>
            <p class="text-muted text-sm mb-6">None held yet. This is the order they land in.</p>

            <!-- Vertical rail, borrowing the node-and-path language the attack
                 graph already establishes: filled node for the booked exam,
                 hollow for what is still ahead. -->
            <ol class="relative z-10 flex flex-col">
              {certs.map((c, i) => (
                <li class="relative flex gap-4 pb-6 last:pb-0">
                  {i < certs.length - 1 && (
                    <span class="absolute left-[5px] top-4 bottom-0 w-px bg-border" aria-hidden="true"></span>
                  )}
                  <span
                    class:list={[
                      'mt-1.5 w-[11px] h-[11px] rounded-full shrink-0 border',
                      c.current ? 'bg-accent border-accent' : 'bg-bg border-borderHover',
                    ]}
                    aria-hidden="true"
                  ></span>
                  <div class="flex-1 min-w-0">
                    <div class="flex items-baseline justify-between gap-3">
                      <span class:list={['text-sm font-medium', c.current ? 'text-white' : 'text-zinc-300']}>{c.name}</span>
                      <span
                        class:list={[
                          'font-mono text-[10px] tracking-wider shrink-0',
                          c.current ? 'text-accent bg-accent/10 px-2 py-0.5 rounded' : 'text-muted',
                        ]}
                      >{c.status}</span>
                    </div>
                    <p class="text-[11px] font-mono text-muted mt-1">{c.issuer}</p>
                  </div>
                </li>
              ))}
            </ol>

            <p class="relative z-10 mt-auto pt-6 border-t border-border text-[11px] font-mono text-muted leading-relaxed">
              Also in progress: Cybersecurity &amp; Cloud BSc, Hogeschool Utrecht.
            </p>
          </div>
        </div>

        <!-- Toolkit -->
        <div class="spotlight-card md:col-span-1 h-auto md:h-[360px]" data-reveal data-reveal-delay="2">
          <div class="spotlight-content p-8 flex flex-col relative overflow-hidden">
            <div class="absolute -top-16 -right-16 w-48 h-48 bg-accent/[0.07] rounded-full blur-3xl"></div>

            <div class="flex items-center gap-3 mb-6">
              <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center text-accent border border-accent/20">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2"/></svg>
              </div>
              <h3 class="font-medium text-white">The Toolkit</h3>
            </div>

            <div class="relative z-10 flex flex-col gap-5">
              {toolkit.map((g) => (
                <div>
                  <h4 class="text-[10px] font-mono text-muted uppercase tracking-widest mb-2">{g.label}</h4>
                  <div class="flex flex-wrap gap-1.5">
                    {g.tools.map((t) => (
                      <span class="px-2 py-1 border border-border rounded text-[11px] font-mono text-zinc-400 bg-bg">{t}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Homelab -->
        <div class="spotlight-card md:col-span-2 h-auto md:h-[360px]" data-reveal data-reveal-delay="3">
          <div class="spotlight-content p-8 flex flex-col md:flex-row items-center gap-8 relative overflow-hidden">
            <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-accent/10 rounded-full blur-3xl"></div>

            <div class="w-full md:w-1/2">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center text-accent border border-accent/20">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="7" rx="1"/><rect x="3" y="14" width="18" height="6" rx="1"/><path d="M7 7.5h.01M7 17h.01"/></svg>
                </div>
                <h3 class="font-medium text-white">Active Directory Homelab</h3>
              </div>
              <p class="text-muted text-sm leading-relaxed mb-6">
                A Windows Server 2022 domain controller and two workstations at home, so every chain I read about gets rebuilt outside the platform: Kerberos abuse, BloodHound paths, NTLM relay.
              </p>
              <a href="/projects" class="inline-flex items-center gap-2 text-sm text-white font-medium hover:text-accent transition-colors">
                See the lab
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>

            <div class="w-full md:w-1/2 relative rounded-2xl overflow-hidden border border-border bg-bg p-6 flex items-center justify-center">
              <svg viewBox="0 0 320 130" class="w-full h-auto max-h-56 attack-graph" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Home lab topology: a Server 2022 domain controller with two joined workstations.">
                <defs>
                  <pattern id="labDots" width="20" height="20" patternUnits="userSpaceOnUse">
                    <circle cx="2" cy="2" r="1" class="grid-dot" />
                  </pattern>
                </defs>
                <rect width="100%" height="100%" fill="url(#labDots)" />

                <path d="M 160 46 L 160 68" class="edge-primary" />
                <path d="M 160 68 L 70 68 L 70 90" class="edge-secondary" />
                <path d="M 160 68 L 250 68 L 250 90" class="edge-secondary" />

                <rect x="90" y="18" width="140" height="28" class="node-rect-accent" />
                <text x="160" y="33" class="node-text-accent">DC01 · Server 2022</text>

                <rect x="25" y="90" width="90" height="28" class="node-rect" />
                <text x="70" y="105" class="node-text">WS01</text>

                <rect x="205" y="90" width="90" height="28" class="node-rect" />
                <text x="250" y="105" class="node-text">WS02</text>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= CONTACT ================= -->
