const wait = s => new Promise(r=>gsap.delayedCall(s,r));
function pushIn(a){
  gsap.to(camera.position,{z:CAM_HOME.z-a*3.0, y:CAM_HOME.y+a*.2,
    duration:2.4, ease:'power2.inOut', overwrite:'auto', onUpdate:()=>camera.lookAt(LOOK)});
}
function cameraHome(d){
