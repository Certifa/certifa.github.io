<style>
  /* Scrim: gives the hero copy its own ground so it never competes with the
     animated field. Soft-edged and generously inset, so it reads as a vignette
     in the background rather than a panel. `position: relative` also activates
     the column's z-10, keeping the scrim above the field but under the text. */
  .hero-copy {
    position: relative;
  }
  .hero-copy::before {
    content: '';
    position: absolute;
    inset: -3rem -4rem -3rem -3rem;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 75% 60% at 30% 45%,
      rgba(9, 9, 11, 0.94) 0%,
      rgba(9, 9, 11, 0.82) 45%,
      rgba(9, 9, 11, 0.45) 68%,
      transparent 85%
    );
  }
  @media (max-width: 767px) {
    /* Stacked layout puts the field directly behind every line, so the scrim
       covers more and sits a touch heavier. */
    .hero-copy::before {
      inset: -2rem -1.5rem;
      background: radial-gradient(
        ellipse 90% 70% at 50% 50%,
        rgba(9, 9, 11, 0.96) 0%,
        rgba(9, 9, 11, 0.88) 55%,
        rgba(9, 9, 11, 0.5) 75%,
        transparent 90%
      );
    }
  }

  /* Attack-path graph */
  .attack-graph { font-family: 'JetBrains Mono', monospace; }
  .attack-graph :global(.grid-dot) { fill: rgba(255, 255, 255, 0.04); }
  .attack-graph :global(.edge-primary) { stroke: #4ade80; stroke-width: 1.5; fill: none; }
  .attack-graph :global(.edge-secondary) {
    stroke: rgba(255, 255, 255, 0.2); stroke-width: 1; stroke-dasharray: 3 3; fill: none;
  }
  .attack-graph :global(.node-rect) { fill: transparent; stroke: rgba(255, 255, 255, 0.15); stroke-width: 1; rx: 2; }
  .attack-graph :global(.node-rect-accent) { fill: transparent; stroke: #4ade80; stroke-width: 1; rx: 2; }
  .attack-graph :global(.node-text) { fill: #d4d4d8; text-anchor: middle; dominant-baseline: middle; font-size: 10px; }
  .attack-graph :global(.node-text-accent) { fill: #4ade80; text-anchor: middle; dominant-baseline: middle; font-size: 10px; }
  .attack-graph :global(.node-num) { fill: rgba(255, 255, 255, 0.5); font-size: 8px; text-anchor: middle; dominant-baseline: middle; }
  .attack-graph :global(.node-num-circle) { fill: #0f0f12; stroke: rgba(255, 255, 255, 0.15); stroke-width: 1; }
  .attack-graph :global(.arrow-primary) { fill: #4ade80; }
  .attack-graph :global(.arrow-secondary) { fill: rgba(255, 255, 255, 0.2); }

  /* Bento spotlight cards */
  .spotlight-card {
    position: relative;
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 1rem;
    overflow: hidden;
  }
  .spotlight-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    background: radial-gradient(
      800px circle at var(--mouse-x, 50%) var(--mouse-y, 50%),
      rgba(255, 255, 255, 0.06),
      transparent 40%
    );
    z-index: 1;
  }
  .spotlight-card:hover::before { opacity: 1; }
  .spotlight-card > .spotlight-content {
    position: relative;
    z-index: 2;
    height: 100%;
    border-radius: inherit;
  }

  /* Scanning line. The export referenced an undefined custom property here,
     so the gradient never rendered; wired to the real accent. */
  .scan-line {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 2px;
    background: linear-gradient(90deg, transparent, #4ade80, transparent);
    box-shadow: 0 0 10px rgba(74, 222, 128, 0.6);
    animation: scan 3s linear infinite;
    opacity: 0.5;
    z-index: 10;
  }
  @keyframes scan {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(400px); }
  }

  @media (prefers-reduced-motion: reduce) {
    .scan-line { display: none; }
  }
</style>

<script>
  // Spotlight follows the cursor across the bento cards.
  document.querySelectorAll<HTMLElement>('.spotlight-card').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
      card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
    });
  });

</script>
