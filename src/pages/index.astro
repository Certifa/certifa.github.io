// drop a loaded model on the desk. `size` targets the LARGEST dimension,
// normalising by height alone is meaningless for a flat object like a gamepad.
function place(obj, {x, z, y = -2.35, size, rotY = 0, shadow = true}){
  const b = new THREE.Box3().setFromObject(obj);
  const s = new THREE.Vector3(); b.getSize(s);
  obj.scale.setScalar(size / Math.max(s.x, s.y, s.z));
  const b2 = new THREE.Box3().setFromObject(obj);
  obj.position.set(x, y - b2.min.y, z);          // sit it exactly on the surface
  obj.rotation.y = rotY;
  if (shadow) obj.traverse(o => { if (o.isMesh){ o.castShadow = true; o.receiveShadow = true; } });
  room.add(obj);
  return obj;
}




