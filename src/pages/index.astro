/* ===================== SCREEN DRAWING ===================== */
const PAD = 40, LINE = 37, FONT = '25px "Cascadia Code", Consolas, monospace';
const TOPBAR = 64;
const MAXLINES = Math.floor((CH - PAD - TOPBAR - 30) / LINE);

let shown = [];
let heat = 0, flash = 0, powered = 0, caretOnly = false;
let statusWho='john.w @ DC01.darkzero.htb', statusPriv='domain user', statusLvl=0;

function drawScreen(){
  const bg = ctx.createLinearGradient(0,0,0,CH);
  bg.addColorStop(0, `rgb(${7+heat*13},${8+heat*3},${11+heat*3})`);
  bg.addColorStop(1, `rgb(${4+heat*8},${4+heat*2},${6+heat*2})`);
  ctx.fillStyle = bg; ctx.fillRect(0,0,CW,CH);

  if (powered > .96){
    ctx.fillStyle = 'rgba(255,255,255,.03)'; ctx.fillRect(0,0,CW,TOPBAR);
    ctx.fillStyle = 'rgba(255,255,255,.06)'; ctx.fillRect(0,TOPBAR-1,CW,1);

    ctx.font = '20px "Cascadia Code", Consolas, monospace';
    ctx.textBaseline='middle'; ctx.fillStyle='#a8a49d';
    ctx.fillText(statusWho, PAD, TOPBAR/2);
    const whoW = ctx.measureText(statusWho).width;

    const priv = statusPriv.toUpperCase();
    ctx.font = '13px "Cascadia Code", Consolas, monospace';
    const pw = ctx.measureText(priv).width, bx = PAD+whoW+30;
    ctx.strokeStyle = PRIV_COL[statusLvl]; ctx.lineWidth=1;
    ctx.strokeRect(bx, TOPBAR/2-13, pw+22, 26);
    ctx.fillStyle = PRIV_COL[statusLvl];
    ctx.fillText(priv, bx+11, TOPBAR/2);

    ctx.font = FONT; ctx.textBaseline='top';
    const start = Math.max(0, shown.length-MAXLINES);
    const visible = Math.max(1, shown.length-start);
    for(let i=start;i<shown.length;i++){
      const l = shown[i], y = TOPBAR+22+(i-start)*LINE;
      const age = (i-start)/Math.max(1,visible-1);
      ctx.globalAlpha = 0.36 + 0.64*Math.pow(age,.85);
      ctx.fillStyle = COL[l.c] || COL.out;
      const txt = l.t.slice(0,l.chars);
      ctx.fillText(txt, PAD, y);
      if (l.redacted && l.chars >= l.t.length){
        const w = ctx.measureText(l.t).width;
        ctx.font='12px "Cascadia Code", Consolas, monospace'; ctx.fillStyle='#67625b';
        ctx.fillText('redacted · HTB flags are not published', PAD+w+18, y+3);
        ctx.font=FONT;
      }
      if (i===shown.length-1 && l.chars<l.t.length){
        const w=ctx.measureText(txt).width;
        ctx.fillStyle='#d4492f'; ctx.fillRect(PAD+w+2,y+2,9,18);
      }
      ctx.globalAlpha = 1;
    }
    if (caretOnly && (performance.now()/520|0)%2===0){
      ctx.fillStyle='#d4492f'; ctx.fillRect(PAD,TOPBAR+24,9,18);
    }
  }

  if (powered < 1){
    const h = Math.max(2, CH*powered);
    ctx.fillStyle='#000';
    ctx.fillRect(0,0,CW,(CH-h)/2); ctx.fillRect(0,(CH+h)/2,CW,(CH-h)/2);
  }
  if (flash > 0){
    ctx.fillStyle=`rgba(255,${150+80*(1-flash)},90,${flash*.42})`;
    ctx.fillRect(0,0,CW,CH);
  }
  ctx.fillStyle='rgba(0,0,0,.13)';
  for(let y=0;y<CH;y+=3) ctx.fillRect(0,y,CW,1);

  screenTex.needsUpdate = true;
}

