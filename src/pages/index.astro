  function svgFor(name) {
    const segs = ICONS[name]().map(([a, b]) => [P(a), P(b)]);
    const xs = segs.flat().map(p => p[0]), ys = segs.flat().map(p => p[1]);
    const minX = Math.min(...xs) - 8, minY = Math.min(...ys) - 8, w = Math.max(...xs) - minX + 8, h = Math.max(...ys) - minY + 8;
    const d = segs.map(([a, b]) => `M${a[0].toFixed(1)} ${a[1].toFixed(1)}L${b[0].toFixed(1)} ${b[1].toFixed(1)}`).join('');
