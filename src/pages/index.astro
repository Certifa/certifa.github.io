    duration:d, ease:'power2.inOut', overwrite:'auto', onUpdate:()=>camera.lookAt(LOOK)});
}

function typeLine(src, idx){
  return new Promise(res=>{
    const e = {t:src.t, c:src.c, chars:0, redacted:src.redacted};
    shown.push(e);
    if (shown.length > MAXLINES+8) shown.shift();
    if (src.stage){
      lblS.textContent=src.stage[0]; lblW.textContent=src.stage[1];
      gsap.fromTo(lblEl,{opacity:0,x:14},{opacity:1,x:0,duration:.3,ease:'power4.out'});
    }
    if (src.ctx){ statusWho=src.ctx[0]; statusPriv=src.ctx[1]; statusLvl=src.ctx[2]; }
    if (src.push) pushIn(src.push);
    setHeat(Math.min(1, idx/(SCRIPT.length-2)));
    if (src.c==='cmd'){
      gsap.to(e,{chars:src.t.length, duration:Math.min(1.4,src.t.length*.015),
        ease:'none', onComplete:()=>gsap.delayedCall(.18,res)});
    } else {
      e.chars = src.t.length;
      gsap.delayedCall((src.c==='hot'||src.c==='good')?.6:.24, res);
    }
  });
}

async function runReplay(){
  for(;;){
    shown=[]; setHeat(0); flash=0;
    statusWho='john.w @ DC01.darkzero.htb'; statusPriv='domain user'; statusLvl=0;
    gsap.set(lblEl,{opacity:0});
    powered=0; caretOnly=false;
    camera.position.copy(CAM_HOME); camera.lookAt(LOOK);
    await wait(.5);
    await new Promise(r=>{const o={v:0};gsap.to(o,{v:1,duration:.5,ease:'power3.out',
      onUpdate:()=>{powered=o.v;}, onComplete:r});});
    caretOnly=true; await wait(1.5); caretOnly=false;

    for(let i=0;i<SCRIPT.length;i++){
      const s = SCRIPT[i];
      await typeLine(s,i);
      if (s.wait) await wait(s.wait);
      if (s.c==='root'){ const o={v:1};
        gsap.to(o,{v:0,duration:2.4,ease:'power2.out',onUpdate:()=>{flash=o.v;}}); }
    }
    await wait(3.6);
    cameraHome(2.6);
    gsap.to(lblEl,{opacity:0,duration:.7});
    await new Promise(r=>{const o={v:1};gsap.to(o,{v:0,duration:.55,ease:'power3.in',
      onUpdate:()=>{powered=o.v;}, onComplete:r});});
    await wait(1.1);
  }
}

