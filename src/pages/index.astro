  }
  document.querySelectorAll('[data-icon]').forEach(el => el.innerHTML = svgFor(el.dataset.icon));

  // ---- small line icons (Lucide style)
  const ICO = {
    home: '<path d="M3 10.5 12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/>',
    file: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/><path d="M8 13h8M8 17h6"/>',
