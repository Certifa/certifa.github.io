    enter: '<path d="M9 10 4 15l5 5"/><path d="M20 4v7a4 4 0 0 1-4 4H4"/>',
    clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  };
  const paint = root => root.querySelectorAll('i[data-i]').forEach(el => { el.innerHTML = `<svg viewBox="0 0 24 24">${ICO[el.dataset.i] || ''}</svg>`; });
  paint(document);

  // ---- aegis console: each call is checked against policy, then appended to the signed log
  const CALLS = [
    { call: 'read_file("/secrets/db.env")', rule: 'secrets', v: 'deny' },
    { call: 'make_payment(eur=40)', rule: 'pay', v: 'allow' },
    { call: 'make_payment(eur=5000)', rule: 'default', v: 'deny', note: 'injected doc' },
    { call: 'send_email(to="ext")', rule: 'default', v: 'deny' },
  ];
  const callsEl = document.getElementById('calls'), ledger = document.getElementById('ledger'), dot = document.getElementById('dot');
  const rules = [...document.querySelectorAll('#policy span')];
  callsEl.innerHTML = CALLS.map(c => `<li>${c.call}${c.note ? `<em>${c.note}</em>` : ''}</li>`).join('');
  const rows = [...callsEl.children];
  // FNV-1a, only to show that every entry carries the hash of the one before it
  const fnv = s => { let h = 0x811c9dc5; for (const ch of s) { h ^= ch.charCodeAt(0); h = Math.imul(h, 0x01000193) >>> 0; } return h.toString(16).padStart(8, '0'); };
  let prev = '00000000', seq = 141, step = 0;
  function tick() {
    const c = CALLS[step % CALLS.length];
    rows.forEach((r, i) => r.classList.toggle('cur', i === step % CALLS.length));
    rules.forEach(r => r.className = '');
    dot.classList.remove('go'); void dot.offsetWidth; dot.classList.add('go');
    setTimeout(() => {
      const rule = rules.find(r => r.dataset.r === c.rule);
      rule.className = c.v === 'allow' ? 'hit-allow' : 'hit-deny';
      const h = fnv(prev + c.call + c.v);
      const li = document.createElement('li');
      li.innerHTML = `<span>#${++seq}</span><span class="v ${c.v}">${c.v.toUpperCase()}</span><span>${c.call.split('(')[0]}</span><small>prev <b>${prev}</b> &rarr; <b>${h}</b>, signed</small>`;
      ledger.prepend(li);
      while (ledger.children.length > 4) ledger.lastChild.remove();
      prev = h;
    }, reduce ? 0 : 650);
    step++;
  }
  if (reduce) for (let i = 0; i < 4; i++) tick();
  else {
    tick();
    let id = null;
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !id) id = setInterval(tick, 2300);
      if (!e.isIntersecting && id) { clearInterval(id); id = null; }
    }).observe(document.getElementById('schema'));
  }


  // ---- rotating focus word; clicking it runs that search
  const rot = document.getElementById('rot'), rotIn = rot.firstElementChild, words = [...rotIn.children];
  let ri = 0;
  const setRot = () => { rot.style.width = words[ri].offsetWidth + 'px'; rotIn.style.transform = `translateY(${-ri * words[0].offsetHeight}px)`; };
  document.fonts.ready.then(setRot);
  if (!reduce) setInterval(() => { if (!document.hidden) { ri = (ri + 1) % words.length; setRot(); } }, 2600);
  rot.addEventListener('click', () => { const q = document.getElementById('q'); q.value = words[ri].textContent.toLowerCase(); q.focus(); q.dispatchEvent(new Event('input')); });

  // ---- reading progress
  const bar = document.getElementById('progress');
  const prog = () => { const max = document.documentElement.scrollHeight - innerHeight; bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`; };
  addEventListener('scroll', prog, { passive: true }); prog();

  // ---- two headings type themselves in once, with the layout reserved up front
  document.querySelectorAll('.lab h2, .contact h2 a').forEach(h => {
    if (reduce) return;
    const text = h.textContent;
    h.classList.add('typed');
    h.innerHTML = `<span class="done"></span><span class="tcaret"></span><span class="ghost">${text}</span>`;
    const done = h.firstChild, ghost = h.lastChild;
    const io = new IntersectionObserver(([e]) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      let i = 0;
      const t = setInterval(() => {
        i++; done.textContent = text.slice(0, i); ghost.textContent = text.slice(i);
        if (i >= text.length) { clearInterval(t); setTimeout(() => h.querySelector('.tcaret').remove(), 900); }
      }, 34);
    }, { threshold: 0.8 });
    io.observe(h);
  });

  // ---- dithered terrain strip, ordered 4x4 Bayer
  const cv = document.getElementById('dither'), ctx = cv.getContext('2d');
  const B = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map(v => (v + 0.5) / 16);
  const hash = (x, y) => { const n = Math.sin(x * 127.1 + y * 311.7) * 43758.5453; return n - Math.floor(n); };
  const sm = t => t * t * (3 - 2 * t);
  const noise = (x, y) => {
    const xi = Math.floor(x), yi = Math.floor(y), xf = sm(x - xi), yf = sm(y - yi);
    const a = hash(xi, yi), b = hash(xi + 1, yi), c = hash(xi, yi + 1), d = hash(xi + 1, yi + 1);
    return a + (b - a) * xf + (c - a) * yf + (a - b - c + d) * xf * yf;
  };
  const fbm = (x, y) => noise(x, y) * .6 + noise(x * 2.1, y * 2.1) * .3 + noise(x * 4.3, y * 4.3) * .1;
  const PX = 3;
  function drawDither(t) {
    const dpr = devicePixelRatio || 1, w = cv.clientWidth, h = cv.clientHeight;
    if (cv.width !== w * dpr) { cv.width = w * dpr; cv.height = h * dpr; }
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, w, h);
    ctx.fillStyle = '#9a9a9a';
    const cols = Math.ceil(w / PX), rows = Math.ceil(h / PX);
    for (let y = 0; y < rows; y++) {
      const v = y / rows;
      for (let x = 0; x < cols; x++) {
        const u = x / cols;
        let val = 0;
        for (let k = 0; k < 3; k++) {
          const ridge = 0.3 + k * 0.2 + (fbm(u * (2 + k) * 1.6 + t * 0.012 * (k + 1), k * 3.1) - 0.5) * 0.55;
          if (v > ridge) val = (0.78 - k * 0.22) * (1 - (v - ridge) * 0.9) + (fbm(x * 0.05, y * 0.12 + k) - 0.5) * 0.25;
        }
        if (val > B[(y % 4) * 4 + (x % 4)]) ctx.fillRect(x * PX, y * PX, PX - 0.6, PX - 0.6);
      }
    }
  }
  let visible = false;
  new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(cv);
  drawDither(0);
  if (!reduce) { let last = 0; const loop = n => { if (visible && n - last > 90) { drawDither(n / 1000); last = n; } requestAnimationFrame(loop); }; requestAnimationFrame(loop); }

  // ---- footer wordmark: the name rasterised, then dithered with the same Bayer pattern
  const wm = document.getElementById('wordmark'), wctx = wm.getContext('2d');
  let mask = null, mw = 0, mh = 0;
  function buildMask() {
    const w = wm.clientWidth, h = wm.clientHeight;
    mw = Math.ceil(w / PX); mh = Math.ceil(h / PX);
    const off = document.createElement('canvas'); off.width = mw; off.height = mh;
    const o = off.getContext('2d');
    let size = mh * 1.25;
    o.font = `600 ${size}px Geist, sans-serif`;
    size *= (mw * 0.96) / o.measureText('certifa').width;
    o.font = `600 ${size}px Geist, sans-serif`;
    o.textAlign = 'center'; o.textBaseline = 'alphabetic'; o.fillStyle = '#fff';
    o.fillText('certifa', mw / 2, mh * 0.86);
    mask = o.getImageData(0, 0, mw, mh).data;
  }
  function drawWordmark(t) {
    const dpr = devicePixelRatio || 1, w = wm.clientWidth, h = wm.clientHeight;
    if (!w || !h) return;
    if (wm.width !== w * dpr || wm.height !== h * dpr) { wm.width = w * dpr; wm.height = h * dpr; buildMask(); }
    wctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    wctx.clearRect(0, 0, w, h);
    wctx.fillStyle = '#9a9a9a';
    const sweep = (t * 0.08) % 1.6 - 0.3;
    for (let y = 0; y < mh; y++) {
      const v = y / mh;
      for (let x = 0; x < mw; x++) {
        const a = mask[(y * mw + x) * 4 + 3] / 255;
        if (!a) continue;
        const u = x / mw;
        const val = a * (0.85 - v * 0.6) + Math.max(0, 0.25 - Math.abs(u - sweep) * 1.5);
        if (val > B[(y % 4) * 4 + (x % 4)]) wctx.fillRect(x * PX, y * PX, PX - 0.6, PX - 0.6);
      }
    }
  }
  let wmVisible = false;
  new IntersectionObserver(([e]) => { wmVisible = e.isIntersecting; }).observe(wm);
  document.fonts.ready.then(() => {
    drawWordmark(0);
    addEventListener('resize', () => { wm.width = 0; drawWordmark(0); });
    if (!reduce) { let last = 0; const loop = n => { if (wmVisible && n - last > 90) { drawWordmark(n / 1000); last = n; } requestAnimationFrame(loop); }; requestAnimationFrame(loop); }
  });
})();

(() => {
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // quiet ascii: a bust rising out of hills, mist drifting through. grey only.
  const el = document.getElementById('ascii');
  const RAMP = " .'`^,:;Il!i><~+_-?][}{1)(|/tfjrxnuvczXYUJCLQ0OZmwqpdbkhao*#MW&8%B@$";
  const hash = (x, y) => { const n = Math.sin(x * 127.1 + y * 311.7) * 43758.5453; return n - Math.floor(n); };
  const sm = t => t * t * (3 - 2 * t);
  const noise = (x, y) => {
    const xi = Math.floor(x), yi = Math.floor(y), xf = sm(x - xi), yf = sm(y - yi);
    const a = hash(xi, yi), b = hash(xi + 1, yi), c = hash(xi, yi + 1), d = hash(xi + 1, yi + 1);
    return a + (b - a) * xf + (c - a) * yf + (a - b - c + d) * xf * yf;
  };
  const fbm = (x, y) => noise(x, y) * .6 + noise(x * 2.1, y * 2.1) * .3 + noise(x * 4.3, y * 4.3) * .1;
  let cols, rows, ar;
  function measure() {
    const p = document.createElement('span'); p.textContent = 'M'.repeat(50); el.appendChild(p);
    const cw = p.getBoundingClientRect().width / 50; el.removeChild(p);
    cols = Math.floor(el.clientWidth / cw); rows = Math.floor(el.clientHeight / 12); ar = (cols * cw) / (rows * 12);
  }
  function frame(t) {
    let out = '';
    for (let y = 0; y < rows; y++) {
      const v = y / rows;
      let line = '';
      for (let x = 0; x < cols; x++) {
        const u = x / cols, ua = u * ar;
        let b = 0;
        // three ridges of hills, the furthest one lightest
        for (let k = 0; k < 3; k++) {
          const ridge = 0.58 + k * 0.08 + (fbm(u * (2 + k), k * 3.7) - 0.5) * 0.22;
          if (v > ridge) b = (0.55 - k * 0.12) * (0.75 + 0.5 * (fbm(x * 0.09, y * 0.18 + k) - 0.5));
        }
        // the bust: head and shoulders, lit from the left
        const cx = 0.47 * ar;
        const hd = ((ua - cx) / 0.075) ** 2 + ((v - 0.36) / 0.13) ** 2;
        const sh = ((ua - cx) / 0.24) ** 2 + ((v - 0.78) / 0.3) ** 2;
        const nk = Math.abs(ua - cx) < 0.04 && v > 0.44 && v < 0.54;
        if (hd < 1 || sh < 1 || nk) {
          const light = 0.5 + (cx - ua) * 2.2;
          b = Math.max(0.12, Math.min(0.85, light * (0.7 + 0.5 * (fbm(x * 0.12, y * 0.12) - 0.5))));
        }
        // mist
        const m = fbm(u * 3 - t * 0.04, v * 5 + t * 0.012);
        b += Math.max(0, m - 0.5) * 0.5 * sm(Math.min(1, Math.max(0, (v - 0.35) * 2)));
        // faint shimmer so the field feels alive
        b *= 0.94 + 0.06 * hash(x + Math.floor(t * 8), y);
        line += RAMP[Math.min(RAMP.length - 1, Math.max(0, b) * (RAMP.length - 1) | 0)];
      }
      out += line + '\n';
    }
    el.textContent = out;
  }
  measure();
  addEventListener('resize', measure);
  if (reduce) frame(0);
  else {
    let last = 0, heroVisible = true;
    new IntersectionObserver(([e]) => { heroVisible = e.isIntersecting; }).observe(el);
    const loop = n => { if (heroVisible && !document.hidden && n - last > 66) { frame(n / 1000); last = n; } requestAnimationFrame(loop); };
    requestAnimationFrame(loop);
  }
  requestAnimationFrame(() => el.classList.add('on'));

  // search: built from the writeup cards on the page, quiet until someone uses it
  const input = document.getElementById('q'), drop = document.getElementById('drop');
  const list = document.getElementById('results'), none = document.getElementById('none'), chips = document.getElementById('chips');
  const index = [...document.querySelectorAll('.app .card')].map(c => ({
    name: c.querySelector('b').textContent,
    diff: c.closest('.col').querySelector('.diff').textContent,
    os: c.querySelector('.tags span').textContent.trim(),
    text: c.querySelector('p').textContent,
    href: c.getAttribute('href') || '#',
    hay: (c.textContent + ' ' + c.closest('.col').querySelector('.diff').textContent + ' ' + (c.dataset.topics || '')).toLowerCase(),
  }));
  const esc = t => t.replace(/[&<>"]/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]));
  let hits = [], act = 0;
  function render() {
    const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    chips.hidden = terms.length > 0;
    hits = terms.length ? index.filter(w => terms.every(t => w.hay.includes(t))) : [];
    act = Math.min(act, Math.max(0, hits.length - 1));
    list.innerHTML = hits.map((w, i) => `<li class="${i === act ? 'act' : ''}" role="option"><a href="${w.href}"><b>${esc(w.name)}</b><span class="diff ${w.diff.toLowerCase()}">${esc(w.diff)}</span><em>${esc(w.os)}</em><small>${esc(w.text)}</small></a></li>`).join('');
    none.hidden = !(terms.length && !hits.length);
    if (!none.hidden) none.textContent = `No writeup matches "${input.value.trim()}". Try a machine name or a topic like active directory.`;
  }
  const open = () => { drop.hidden = false; render(); };
  input.addEventListener('focus', open);
  input.addEventListener('input', () => { act = 0; open(); });
  input.addEventListener('keydown', e => {
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') { e.preventDefault(); if (hits.length) { act = (act + (e.key === 'ArrowDown' ? 1 : hits.length - 1)) % hits.length; render(); } }
    else if (e.key === 'Enter' && hits[act]) location.href = hits[act].href;
    else if (e.key === 'Escape') { drop.hidden = true; input.blur(); }
  });
  chips.addEventListener('click', e => { if (e.target.tagName === 'BUTTON') { input.value = e.target.textContent; input.focus(); act = 0; render(); } });
  document.addEventListener('pointerdown', e => { if (!e.target.closest('#search')) drop.hidden = true; });
  addEventListener('keydown', e => {
    if (e.key === '/' && document.activeElement.tagName !== 'INPUT') { e.preventDefault(); input.focus({ preventScroll: false }); }
  });

  // demo: the box types example searches until someone uses it, then it is just a search box
  const demo = document.getElementById('demo'), hit = document.getElementById('hit');
  const hn = document.getElementById('hitName'), hm = document.getElementById('hitMeta');
  const PH = input.placeholder;
  const examples = ['shellshock', 'golden ticket', 'docker'];
  const sleep = ms => new Promise(r => setTimeout(r, ms));
  let gen = 0;
  function stopDemo() { gen++; demo.innerHTML = ''; hit.classList.remove('show'); input.placeholder = PH; }
  async function startDemo() {
    if (reduce || document.activeElement === input || input.value) return;
    const me = ++gen;
    input.placeholder = '';
    const alive = () => me === gen;
    for (let k = 0; alive(); k = (k + 1) % examples.length) {
      const text = examples[k];
      const top = index.find(w => text.split(' ').every(t => w.hay.includes(t)));
      for (let c = 1; c <= text.length && alive(); c++) { demo.innerHTML = esc(text.slice(0, c)) + '<span class="caret"></span>'; await sleep(55 + Math.random() * 60); }
      await sleep(350); if (!alive()) return;
      if (top) { hn.textContent = top.name; hm.textContent = `${top.diff}, ${top.os}`; hit.classList.add('show'); }
      await sleep(2600); if (!alive()) return;
      hit.classList.remove('show');
      for (let c = text.length; c >= 0 && alive(); c--) { demo.innerHTML = esc(text.slice(0, c)) + '<span class="caret"></span>'; await sleep(18); }
      await sleep(400);
    }
  }
  input.addEventListener('focus', stopDemo);
  input.addEventListener('blur', () => setTimeout(startDemo, 1500));
  setTimeout(startDemo, 1600);
})();
</script>
