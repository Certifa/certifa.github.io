  // ---- isometric wireframe icons, every edge drawn, chalk filter on top
  const C = Math.cos(Math.PI / 6);
  const P = ([x, y, z]) => [(x - y) * C, (x + y) * 0.5 - z];
  const EDGES = [[0,1],[2,3],[4,5],[6,7],[0,2],[1,3],[4,6],[5,7],[0,4],[1,5],[2,6],[3,7]];
  function box(x, y, z, w, d, h) {
    const c = [];
    for (const dx of [0, w]) for (const dy of [0, d]) for (const dz of [0, h]) c.push([x + dx, y + dy, z + dz]);
    return EDGES.map(([a, b]) => [c[a], c[b]]);
  }
  const ICONS = {
    server: () => [0, 16, 32].flatMap(z => [
      ...box(-30, -20, z, 60, 40, 12),
      [[-22, 20, z + 6], [-8, 20, z + 6]], [[16, 20, z + 6], [20, 20, z + 6]],
    ]),
    network: () => {
      const cubes = [[-44, -12, 0, 18, 18, 34], [6, -40, 0, 16, 16, 16], [14, 12, 0, 16, 16, 16]];
      const top = ([x, y, z, w, d, h]) => [x + w / 2, y + d / 2, z + h];
      return [...cubes.flatMap(c => box(...c)), [top(cubes[0]), top(cubes[1])], [top(cubes[0]), top(cubes[2])], [top(cubes[1]), top(cubes[2])]];
    },
    books: () => [
      ...box(-30, -20, 0, 56, 40, 8), ...box(-26, -18, 8, 50, 36, 7), ...box(-32, -16, 15, 54, 34, 8),
      [[26, -16, 4], [26, 16, 4]], [[24, -14, 11.5], [24, 14, 11.5]], [[22, -12, 19], [22, 14, 19]],
    ],
    cert: () => [
      ...box(-32, -3, 0, 64, 6, 44), ...box(-26, 3, 6, 52, 1, 32),
      [[-18, 4, 30], [18, 4, 30]], [[-18, 4, 24], [10, 4, 24]], [[-18, 4, 18], [4, 4, 18]],
      ...box(12, 4, 6, 9, 3, 9), [[14, 7, 6], [12, 7, -4]], [[19, 7, 6], [21, 7, -4]],
    ],
    seat: () => [
      ...box(-18, -18, 20, 36, 36, 5), ...box(-18, -18, 25, 5, 36, 32),
