---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WriteupFeature from '../components/WriteupFeature.astro';
import ContactForm from '../components/ContactForm.astro';

// The export hardcoded three invented writeups. These come from the content
// collection: featured entries, newest first, top three.
const featured = (await getCollection('writeups'))
  .filter((w) => w.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// The three card visuals from the export, with their per-card grading. Cycled
// by position so the treatment holds however many writeups are featured.
const dither =
  "background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.85%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22/%3E%3C/svg%3E'); mix-blend-mode: overlay;";

const visuals = [
  {
    image: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?q=80&w=1200&auto=format&fit=crop',
    imageAlt: 'Server rack',
    imageFilter: 'filter grayscale contrast-125 brightness-75',
    overlay: 'bg-black/50 group-hover:bg-black/30',
  },
  {
    image: 'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?q=80&w=1200&auto=format&fit=crop',
    imageAlt: 'Network wireframe',
    imageFilter: 'filter grayscale contrast-150 brightness-50 sepia-[.2] hue-rotate-[180deg]',
    overlay: 'bg-black/50 group-hover:bg-black/30',
  },
  {
    image: 'https://images.unsplash.com/photo-1555066931-4365d14bab8c?q=80&w=1200&auto=format&fit=crop',
    imageAlt: 'Terminal code execution',
    imageFilter: 'filter grayscale contrast-125 brightness-75 sepia-[.1] hue-rotate-[200deg]',
    overlay: 'bg-black/60 group-hover:bg-black/40',
  },
];
---

<BaseLayout
  title="Certifa"
  description="Offensive security student. I take apart Active Directory environments, web applications, and Linux boxes, then write down exactly how."
  effects
>
  <!-- Export used pt-32/pt-48 measured from the top of the page; main already
       clears the 4rem nav, so these are the remainder. -->
  <div class="w-full pt-16 md:pt-32 pb-24">
    <!-- ================= HERO ================= -->
    <section class="max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 lg:grid-cols-2 gap-16 items-start relative isolate mb-32">
      <!-- WebGL ASCII field from the export, driven by the AIDesigner runtime
           loaded at the bottom of this page. -->
      <div
        data-aifx="ascii"
        data-aifx-colors="#030805,#081a10,#103820,#4ade80"
        data-aifx-bg="#09090b"
        data-aifx-bg-alpha="0"
        data-aifx-speed="0.25"
        data-aifx-scale="1.2"
        data-aifx-glow="0.6"
        class="absolute inset-[0_0_10%_0] -z-10 pointer-events-none opacity-70 [mask-image:radial-gradient(ellipse_at_center,black_40%,transparent_80%)]"
        aria-hidden="true"
      ></div>

      <!-- Left: typography & CTAs -->
      <div class="hero-copy flex flex-col items-start text-left z-10 lg:sticky lg:top-32">
        <div class="flex flex-col gap-4 mb-8">
          <div class="flex items-center gap-3">
            <span class="font-mono text-[10px] text-zinc-400 uppercase tracking-widest">
              OFFENSIVE SECURITY STUDENT <span class="text-accent font-bold">_</span>
            </span>
          </div>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1.5 rounded-[3px] border border-border font-mono text-[11px] text-zinc-300">AD ATTACK CHAIN</span>
            <span class="px-3 py-1.5 rounded-[3px] border border-border font-mono text-[11px] text-zinc-300">KERBEROS</span>
            <span class="px-3 py-1.5 rounded-[3px] border border-border font-mono text-[11px] text-zinc-300">RBCD</span>
          </div>
        </div>

        <h1 class="font-display text-5xl md:text-6xl lg:text-[4rem] font-bold tracking-tight leading-[1.05] text-white mb-8">
          Break systems.<br />
          <span class="text-accent">Document truth.</span>
        </h1>

        <p class="font-mono text-[13px] text-zinc-300 max-w-[28rem] leading-relaxed mb-6">
          I take apart Active Directory environments, web applications, and Linux boxes on HackTheBox: Kerberos abuse, BloodHound, NTLM relay, SQLi, privesc chains, then write down exactly how, start to finish.
        </p>
        <p class="font-mono text-[13px] text-zinc-300 max-w-[28rem] leading-relaxed mb-12">
          Offensive security student at Hogeschool Utrecht, looking for my first red-team seat.
        </p>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 w-full sm:w-auto mb-12">
          <a href="#logs" class="w-full sm:w-auto px-8 py-3 rounded-[3px] border border-border bg-surface text-white font-mono text-[10px] uppercase tracking-widest hover:bg-surfaceHover hover:border-borderHover transition-colors flex items-center justify-center text-center">
            VIEW WRITEUPS
          </a>
          <a href="#infrastructure" class="w-full sm:w-auto px-8 py-3 rounded-[3px] border border-border bg-surface text-white font-mono text-[10px] uppercase tracking-widest hover:bg-surfaceHover hover:border-borderHover transition-colors flex items-center justify-center text-center">
            EXPLORE LAB
          </a>
        </div>

        <a href="#logs" class="font-mono text-[10px] text-zinc-400 hover:text-white transition-colors flex items-center gap-2 border-b border-transparent hover:border-borderHover pb-0.5">
          ↓ see how Pirate fell
        </a>
      </div>

      <!-- Right: static attack-path graph -->
      <div class="flex flex-col w-full z-10">
        <div class="relative w-full rounded-lg overflow-hidden border border-accent/30 bg-surface/90 backdrop-blur p-6 lg:p-8 shadow-[0_0_50px_rgba(74,222,128,0.08)]">
          <div class="absolute top-6 right-6 z-20 hidden sm:flex flex-col gap-3 font-mono text-[9px] text-muted">
            <div class="flex items-center gap-3">
              <span class="w-6 h-[1.5px] bg-accent"></span> Primary Path
            </div>
            <div class="flex items-center gap-3">
              <span class="w-6 border-t border-dashed border-zinc-600"></span> Secondary Paths
            </div>
          </div>

          <div class="relative z-20 w-full flex items-center justify-center">
            <svg viewBox="0 0 400 560" class="w-full h-auto attack-graph" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Attack path: pentest credentials through pre-2000 computer account, gMSA hash dump, WinRM, tunnelling, coerced NTLM relay to RBCD, S4U2Proxy, then user and root flags.">
              <defs>
                <marker id="arrow-accent" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse">
                  <path d="M 0 0 L 10 5 L 0 10 z" class="arrow-primary" />
                </marker>
                <marker id="arrow-gray" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse">
                  <path d="M 0 0 L 10 5 L 0 10 z" class="arrow-secondary" />
                </marker>
                <pattern id="dotGrid" width="20" height="20" patternUnits="userSpaceOnUse">
                  <circle cx="2" cy="2" r="1" class="grid-dot" />
                </pattern>
              </defs>

              <rect width="100%" height="100%" fill="url(#dotGrid)" />

              <!-- Primary path -->
              <path d="M 200 45 L 200 60" class="edge-primary" marker-end="url(#arrow-accent)" />
              <path d="M 200 95 L 200 110" class="edge-primary" marker-end="url(#arrow-accent)" />
              <path d="M 200 145 L 200 160" class="edge-primary" marker-end="url(#arrow-accent)" />
              <path d="M 200 195 L 200 210" class="edge-primary" marker-end="url(#arrow-accent)" />
              <path d="M 200 245 L 200 260" class="edge-primary" marker-end="url(#arrow-accent)" />
              <path d="M 200 305 L 200 320" class="edge-primary" marker-end="url(#arrow-accent)" />

              <!-- Secondary paths -->
              <path d="M 200 355 L 200 370 L 100 370 L 100 380" class="edge-secondary" marker-end="url(#arrow-gray)" />
              <path d="M 200 355 L 200 370 L 255 370 L 255 380" class="edge-secondary" marker-end="url(#arrow-gray)" />
              <path d="M 255 415 L 255 440" class="edge-secondary" marker-end="url(#arrow-gray)" />
              <path d="M 255 475 L 255 490 L 200 490 L 200 500" class="edge-secondary" marker-end="url(#arrow-gray)" />
              <path d="M 100 415 L 100 490 L 200 490" class="edge-secondary" />

              <rect x="120" y="15" width="160" height="30" class="node-rect" />
              <text x="200" y="31" class="node-text">pentest creds</text>
              <circle cx="100" cy="30" r="8" class="node-num-circle" />
              <text x="100" y="31" class="node-num">1</text>

              <rect x="120" y="65" width="160" height="30" class="node-rect" />
              <text x="200" y="81" class="node-text">Pre-2K · MS01$:ms01</text>
              <circle cx="100" cy="80" r="8" class="node-num-circle" />
              <text x="100" y="81" class="node-num">2</text>

              <rect x="120" y="115" width="160" height="30" class="node-rect" />
              <text x="200" y="131" class="node-text">gMSA Hash Dump</text>
              <circle cx="100" cy="130" r="8" class="node-num-circle" />
              <text x="100" y="131" class="node-num">3</text>

              <rect x="120" y="165" width="160" height="30" class="node-rect" />
              <text x="200" y="181" class="node-text">WinRM → DC01</text>
              <circle cx="100" cy="180" r="8" class="node-num-circle" />
              <text x="100" y="181" class="node-num">4</text>

              <rect x="120" y="215" width="160" height="30" class="node-rect" />
              <text x="200" y="231" class="node-text">Ligolo-ng Tunnel</text>
              <circle cx="100" cy="230" r="8" class="node-num-circle" />
              <text x="100" y="231" class="node-num">5</text>

              <rect x="120" y="265" width="160" height="40" class="node-rect" />
              <text x="200" y="280" class="node-text">Coerce + Relay →</text>
              <text x="200" y="294" class="node-text">RBCD on WEB01</text>
              <circle cx="100" cy="285" r="8" class="node-num-circle" />
              <text x="100" y="286" class="node-num">6</text>

              <rect x="120" y="325" width="160" height="30" class="node-rect" />
              <text x="200" y="341" class="node-text">S4U2Proxy · Admin → WEB01</text>
              <circle cx="100" cy="340" r="8" class="node-num-circle" />
              <text x="100" y="341" class="node-num">7</text>

              <rect x="50" y="385" width="100" height="30" class="node-rect" />
              <text x="100" y="401" class="node-text">user.txt</text>
              <circle cx="30" cy="400" r="8" class="node-num-circle" />
              <text x="30" y="401" class="node-num">8</text>

              <rect x="180" y="385" width="150" height="40" class="node-rect" />
              <text x="255" y="400" class="node-text">secretsdump ·</text>
              <text x="255" y="414" class="node-text">a.white creds</text>
              <circle cx="160" cy="405" r="8" class="node-num-circle" />
              <text x="160" y="406" class="node-num">8</text>

              <rect x="180" y="445" width="150" height="30" class="node-rect" />
              <text x="255" y="461" class="node-text">SPN-Jack · HTTP/WEB01</text>
              <circle cx="160" cy="460" r="8" class="node-num-circle" />
              <text x="160" y="461" class="node-num">9</text>

              <rect x="120" y="505" width="160" height="30" class="node-rect-accent" />
              <text x="200" y="521" class="node-text-accent">root.txt</text>
              <circle cx="100" cy="520" r="8" class="node-num-circle" />
              <text x="100" y="521" class="node-num">10</text>
            </svg>
          </div>
        </div>

        <div class="mt-4 font-mono text-[10px] text-zinc-400 flex items-center gap-2 px-2">
          ↳ 11 nodes · 11 edges · full writeup below
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="max-w-7xl mx-auto px-6 md:px-12">
      <div class="w-full h-px bg-gradient-to-r from-border to-transparent mb-24"></div>
    </div>

    <!-- ================= WRITEUPS ================= -->
    <section id="logs" class="max-w-7xl mx-auto px-6 md:px-12 mb-40">
      <div class="flex items-center gap-4 mb-16" data-reveal>
        <div class="w-1 h-6 bg-accent"></div>
        <h2 class="text-2xl font-mono tracking-tight text-white">Threat Intelligence Logs</h2>
      </div>

      <div class="flex flex-col gap-24">
        {featured.map((w, i) => (
          <WriteupFeature
            slug={w.slug}
            title={w.data.title}
            description={w.data.description}
            tags={w.data.tags}
            difficulty={w.data.difficulty}
            platform={w.data.platform}
            kicker={i === 0 ? 'RECENT' : 'ARCHIVE'}
            flip={i % 2 === 1}
            image={visuals[i % visuals.length].image}
            imageAlt={visuals[i % visuals.length].imageAlt}
            imageFilter={visuals[i % visuals.length].imageFilter}
            overlay={visuals[i % visuals.length].overlay}
          />
        ))}
      </div>

      <div class="mt-20 flex justify-center" data-reveal>
        <a href="/writeups" class="px-8 py-3 rounded-[3px] border border-border font-mono text-[10px] uppercase tracking-widest text-white hover:bg-white/5 hover:border-borderHover flex items-center gap-2 transition-all">
          Load Archive
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </a>
      </div>
    </section>

    <!-- ================= ARSENAL ================= -->
    <section id="infrastructure" class="max-w-7xl mx-auto px-6 md:px-12 mb-40">
      <div class="mb-12" data-reveal>
        <h2 class="font-display text-3xl font-semibold tracking-tighter text-white mb-2">Security Arsenal</h2>
        <p class="text-muted">Development, automation, and continuous learning.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Tooling -->
        <div class="spotlight-card group md:col-span-2 h-auto md:h-[400px]" data-reveal>
          <div class="spotlight-content p-8 flex flex-col justify-between overflow-hidden relative">
            <div class="absolute inset-0 bg-gradient-to-br from-white/[0.03] to-transparent pointer-events-none"></div>
            <div class="scan-line hidden md:block"></div>

            <div class="relative z-10">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center text-accent border border-accent/20">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17l6-6-6-6M12 19h8"/></svg>
                </div>
                <h3 class="font-medium text-white">Custom Tooling &amp; Automation</h3>
              </div>
              <p class="text-muted text-sm max-w-md">
                Developing highly concurrent enumeration tools and exploit scripts in Go and Python to streamline infrastructure assessment.
              </p>
            </div>

            <div class="relative z-10 w-full bg-[#0d0d0f] border border-border rounded-lg mt-6 p-4 shadow-2xl transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
              <div class="flex gap-2 mb-4 border-b border-border pb-3">
                <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
                <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
                <span class="ml-4 font-mono text-[10px] text-muted uppercase">enum_engine.go</span>
              </div>
              <pre class="font-mono text-xs leading-relaxed overflow-x-auto text-zinc-400"><code><span class="text-purple-400">func</span> <span class="text-blue-400">ScanTarget</span>(ip <span class="text-teal-400">string</span>, ports []<span class="text-teal-400">int</span>) &#123;
    <span class="text-purple-400">for</span> _, p := <span class="text-purple-400">range</span> ports &#123;
        <span class="text-purple-400">go</span> <span class="text-blue-400">connect</span>(ip, p) <span class="text-zinc-600">// Highly concurrent dialed connections</span>
    &#125;

    <span class="text-zinc-600">// [CRITICAL] Analyzing response heuristics</span>
    <span class="text-purple-400">if</span> vuln == <span class="text-orange-400">true</span> &#123;
        log.<span class="text-blue-400">Printf</span>(<span class="text-green-400">"[+] Exploitable vector identified at %s"</span>, ip)
    &#125;
&#125;</code></pre>
            </div>
          </div>
        </div>

        <!-- Certifications -->
        <div class="spotlight-card md:col-span-1 h-auto md:h-[400px]" data-reveal data-reveal-delay="1">
          <div class="spotlight-content p-8 flex flex-col relative overflow-hidden">
            <div class="absolute top-0 right-0 w-48 h-48 bg-accent/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>

            <div class="flex items-center gap-3 mb-8">
              <div class="w-8 h-8 rounded-lg bg-white/5 flex items-center justify-center text-white border border-border">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="M8.5 14.5L7 22l5-3 5 3-1.5-7.5"/></svg>
              </div>
              <h3 class="font-medium text-white">Certifications</h3>
            </div>

            <div class="flex flex-col gap-4 flex-1 justify-center">
              <div class="flex items-center justify-between p-3 rounded-lg border border-border bg-white/[0.02]">
                <div class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-blue-400 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.2-8.6"/></svg>
                  <span class="text-sm font-medium text-white">CJCA</span>
                </div>
                <span class="font-mono text-[10px] text-blue-400 bg-blue-400/10 px-2 py-0.5 rounded">EXAM_BOOKED</span>
              </div>

              <div class="flex items-center justify-between p-3 rounded-lg border border-border bg-white/[0.02]">
                <div class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
                  <span class="text-sm font-medium text-white">CPTS</span>
                </div>
                <span class="font-mono text-[10px] text-muted">NEXT</span>
              </div>

              <div class="flex items-center justify-between p-3 rounded-lg border border-transparent">
                <div class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/></svg>
                  <span class="text-sm font-medium text-muted">CCNA</span>
                </div>
                <span class="font-mono text-[10px] text-muted">PLANNED</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Sandboxing -->
        <div class="spotlight-card md:col-span-3 h-auto md:h-64" data-reveal data-reveal-delay="2">
          <div class="spotlight-content p-8 flex flex-col md:flex-row items-center gap-8 relative overflow-hidden">
            <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-accent/10 rounded-full blur-3xl"></div>

            <div class="w-full md:w-1/2">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-8 h-8 rounded-lg bg-accent/10 flex items-center justify-center text-accent border border-accent/20">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6h8M9 3h6M6 10h12v6a6 6 0 0 1-12 0zM4 12H2M22 12h-2M5 18l-2 2M19 18l2 2M5 8L3 6M19 8l2-2"/></svg>
                </div>
                <h3 class="font-medium text-white">Malware Analysis Sandboxing</h3>
              </div>
              <p class="text-muted text-sm leading-relaxed mb-6">
                Engineering isolated environments to safely detonate and reverse-engineer malicious payloads, extracting IOCs and understanding execution flow.
              </p>
              <a href="/projects" class="inline-flex items-center gap-2 text-sm text-white font-medium hover:text-accent transition-colors">
                View Research Specs
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>

            <div class="w-full md:w-1/2 relative rounded-2xl overflow-hidden border border-border bg-surface p-1.5 aspect-video group/img">
              <div class="absolute inset-0 bg-black/60 mix-blend-multiply z-10 pointer-events-none group-hover/img:bg-black/40 transition-colors duration-500"></div>
              <div class="absolute inset-0 z-20 pointer-events-none opacity-20" style={dither}></div>
              <img
                src="https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?q=80&w=1200&auto=format&fit=crop"
                alt="Malware sandbox network"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover rounded-lg filter grayscale contrast-125 brightness-50 sepia-[.1] hue-rotate-[180deg] group-hover/img:scale-105 transition-transform duration-700 ease-out"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= CONTACT ================= -->
    <section id="contact" class="max-w-5xl mx-auto px-6 md:px-12 mb-8" data-reveal>
      <div class="rounded-2xl border border-border bg-surface p-8 md:p-12 flex flex-col lg:flex-row gap-12 items-stretch">
        <div class="w-full lg:w-[45%] flex flex-col justify-between gap-8">
          <div>
            <h2 class="font-display text-3xl font-semibold tracking-tighter text-white mb-4">
              Working on something<br />interesting?
            </h2>
            <p class="text-muted text-sm leading-relaxed max-w-md">
              CTF teams, internship leads, lab trades, or feedback on a writeup.<br />
              Pick a channel, they all reach me.
            </p>
          </div>

          <div class="flex flex-wrap gap-2.5">
            <a href="mailto:mike@certifa.net" class="flex items-center gap-2 px-3 py-1.5 rounded-full border border-border bg-white/[0.02] hover:bg-white/10 hover:text-white transition-colors text-xs font-mono text-muted">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
