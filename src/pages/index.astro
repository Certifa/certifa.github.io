<script is:inline>
(() => {
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  

  // origin: split into words, light them by scroll position
  const op = document.getElementById('originText');
  op.innerHTML = op.textContent.split(' ').map(w => `<span>${w}</span>`).join(' ');
  const words = [...op.children];

  // record: machine cards scattered around the line
  const stage = document.getElementById('stage'), story = document.getElementById('story');
  const machines = [
    ['DarkZero', 'Hard, Windows'], ['Pirate', 'Hard, Windows'], ['Gavel', 'Medium, Linux'],
    ['Kobold', 'Easy, Linux'], ['CCTV', 'Easy, Linux'], ['Shocker', 'Easy, Linux'],
    ['Return', 'Easy, Windows'], ['Cicada', 'Easy, Windows'], ['Expressway', 'Easy, Linux'],
  ];
  const spots = [[8,14],[70,10],[4,44],[78,40],[14,74],[64,76],[38,8],[40,84],[86,66]];
  const cards = machines.map(([n, m], i) => {
    const c = document.createElement('div');
    c.className = 'mcard';
    const [d, os] = m.split(', ');
    c.innerHTML = `<b>${n}</b><span class="meta"><span class="diff ${d.toLowerCase()}">${d}</span><i data-i="${os === 'Windows' ? 'monitor' : 'terminal'}"></i>${os}</span>`;
    c.style.left = spots[i][0] + '%'; c.style.top = spots[i][1] + '%';
    stage.appendChild(c);
    return c;
  });
  const line = document.getElementById('storyLine');

  function onScroll() {
    const vh = innerHeight;
    // origin
    const r = op.getBoundingClientRect();
    const p = Math.min(1, Math.max(0, (vh * 0.85 - r.top) / (r.height + vh * 0.4)));
    const lit = reduce ? words.length : Math.round(p * words.length);
    words.forEach((w, i) => w.classList.toggle('lit', i < lit));
    // record
    const s = story.getBoundingClientRect();
    const q = Math.min(1, Math.max(0, -s.top / (s.height - vh)));
    cards.forEach((c, i) => {
      const start = i / cards.length * 0.7, k = reduce ? 1 : Math.min(1, Math.max(0, (q - start) / 0.12));
      const dx = (spots[i][0] < 50 ? -1 : 1) * (1 - k) * 260, dy = (1 - k) * 120;
      c.style.opacity = k;
      c.style.transform = `translate(${dx}px,${dy}px) rotate(${(1 - k) * (i % 2 ? 6 : -6)}deg)`;
    });
    const done = q > 0.86;
    stage.classList.toggle('done', done);
    line.textContent = done ? 'Every step, every command, including what failed first.' : 'Nine machines, written up in full.';
  }
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // aegis: cycle through the three layers, click to choose
  const items = [...document.querySelectorAll('#layers li')], schema = document.getElementById('schema');
  let cur = 0, timer;
  function show(i) {
    cur = i;
    items.forEach((li, j) => { li.classList.remove('on'); void li.offsetWidth; li.classList.toggle('on', j === i); });
    schema.dataset.s = i;
    clearTimeout(timer);
    if (!reduce) timer = setTimeout(() => show((cur + 1) % items.length), 5000);
  }
  items.forEach((li, i) => li.querySelector('button').addEventListener('click', () => show(i)));
  show(0);
})();

(() => {
