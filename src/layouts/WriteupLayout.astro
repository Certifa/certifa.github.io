---
import { existsSync } from 'node:fs';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'writeups'>;
  headings: MarkdownHeading[];
  readingTime: number;
  newer?: CollectionEntry<'writeups'> | null;
  older?: CollectionEntry<'writeups'> | null;
  related?: CollectionEntry<'writeups'>[];
}

const { entry, headings, readingTime, newer = null, older = null, related = [] } = Astro.props;
const { title, date, tags, difficulty, platform, description } = entry.data;

const fmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(date);

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Generated by scripts/make-banners.mjs. Resolved at build, so a box without
// one simply falls back to the plain type-set header.
const box = entry.slug.replace(/^htb-/, '');
const banner = existsSync(`public/images/writeups/${box}/logo.png`)
  ? `/images/writeups/${box}/logo.png`
  : null;
const shareCard = existsSync(`public/og/${box}.png`) ? `/og/${box}.png` : undefined;

// Shared chrome, lifted from the Page_8 card and the Page_14 sidebar so this
// template reads as part of the same system the exports established.
const CARD = 'rounded-xl border border-border bg-surface hover:border-borderHover hover:bg-white/[0.02] transition-all duration-300';
const MICRO = 'font-mono text-[10px] uppercase tracking-widest text-zinc-500';
---
<BaseLayout title={title} description={description} image={shareCard}>
  <div class="wu-progress" id="wuProgress" aria-hidden="true"></div>

  <article class="wu-page pb-24">
    <!-- Header band -->
    <header class="border-b border-border">
      <div class="max-w-6xl mx-auto px-6 pt-10 pb-10">
        <a href="/writeups/" class="inline-flex items-center gap-2 font-mono text-xs text-zinc-500 hover:text-accent transition-colors mb-10 group">
          <span class="transition-transform group-hover:-translate-x-0.5" aria-hidden="true">←</span>
          back to writeups
        </a>

        <div class="font-mono text-xs tracking-wider text-zinc-500 uppercase mb-4 flex items-center gap-2">
          <span class="text-accent">/</span> WRITEUP
        </div>

        {banner ? (
          <>
            {/* The banner sets the title in Space Grotesk already, so the h1 is
                kept for structure and screen readers rather than printed twice. */}
            <img
              src={banner}
              alt={title}
              width="1600"
              height="300"
              decoding="async"
              class="w-full h-auto rounded-xl border border-border mb-7"
            />
            <h1 class="sr-only">{title}</h1>
          </>
        ) : (
          <h1 class="font-display text-4xl md:text-5xl font-bold text-white tracking-tight leading-[1.1] mb-5 max-w-3xl">
            {title}
          </h1>
        )}

        <p class="text-lg text-zinc-400 max-w-2xl leading-relaxed">{description}</p>

        <div class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-3">
          <span class={`diff-pill diff-${difficulty}`}>{difficulty}</span>
          <span class={MICRO}>{platform}</span>
          <span class="text-zinc-700" aria-hidden="true">·</span>
          <span class={MICRO}>{fmt}</span>
          <span class="text-zinc-700" aria-hidden="true">·</span>
          <span class={MICRO}>~{readingTime} min read</span>
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
          {tags.map((t) => (
            <span class="px-2 py-1 text-[10px] font-mono text-muted border border-border rounded">{t}</span>
          ))}
        </div>
      </div>
    </header>

    <!-- Body -->
    <div class="max-w-6xl mx-auto px-6 pt-12 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_260px] gap-8 lg:gap-14 items-start">
      {tocHeadings.length > 0 && (
        <aside class="lg:order-2 lg:sticky lg:top-24 w-full">
          <details class="wu-toc rounded-xl border border-border bg-surface/40 backdrop-blur-sm px-5 py-4" id="wuToc" open>
            <summary class="wu-toc-title flex items-center justify-between gap-3 cursor-pointer list-none">
              <span class={MICRO}>On this page</span>
              <span class="wu-toc-chevron text-zinc-500 text-xs" aria-hidden="true">▾</span>
            </summary>
            <nav class="wu-toc-list mt-4 flex flex-col">
              {tocHeadings.map((h) => (
                <a href={`#${h.slug}`} class={`toc-link depth-${h.depth}`}>{h.text}</a>
              ))}
            </nav>
          </details>
        </aside>
      )}

      <div class="lg:order-1 min-w-0">
        <div class="prose-writeup"><slot /></div>
      </div>
    </div>

    <!-- End of writeup -->
    <footer class="max-w-6xl mx-auto px-6 mt-20">
      <div class="border-t border-border pt-10">
        {related.length > 0 && (
          <section class="mb-12">
            <h2 class={`${MICRO} mb-5`}>Related writeups</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {related.map((r) => (
                <a href={`/writeups/${r.slug}/`} class={`${CARD} group p-5 flex flex-col gap-3`}>
                  <span class={`diff-pill diff-${r.data.difficulty} self-start`}>{r.data.difficulty}</span>
                  <span class="font-display text-lg font-medium text-fg group-hover:text-accent transition-colors">{r.data.title}</span>
                  <span class="font-mono text-[11px] text-zinc-500 leading-relaxed">{r.data.tags.slice(0, 3).join(' · ')}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        <nav class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10" aria-label="More writeups">
          {older ? (
            <a href={`/writeups/${older.slug}/`} class={`${CARD} group p-5 flex flex-col gap-2`}>
              <span class={`${MICRO} flex items-center gap-2`}>
                <span class="transition-transform group-hover:-translate-x-0.5" aria-hidden="true">←</span> Older
              </span>
              <span class="font-display text-base font-medium text-fg group-hover:text-accent transition-colors">{older.data.title}</span>
            </a>
          ) : <span></span>}
          {newer ? (
            <a href={`/writeups/${newer.slug}/`} class={`${CARD} group p-5 flex flex-col gap-2 sm:text-right sm:items-end`}>
              <span class={`${MICRO} flex items-center gap-2`}>
                Newer <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
              </span>
              <span class="font-display text-base font-medium text-fg group-hover:text-accent transition-colors">{newer.data.title}</span>
            </a>
          ) : <span></span>}
        </nav>

        <div class="flex justify-center">
          <a href="/writeups/" class="px-6 py-2.5 text-sm font-medium text-zinc-400 border border-border rounded-lg hover:border-accent hover:text-accent transition-colors">
            All writeups
          </a>
        </div>
      </div>
    </footer>
  </article>

  <!-- Mermaid: render diagram code blocks client-side (loaded only when a diagram exists) -->
  <script type="module" is:inline>
    const diagrams = document.querySelectorAll('pre[data-language="mermaid"]');
    if (diagrams.length > 0) {
      const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        themeVariables: {
          darkMode: true,
          background: '#09090b',
          primaryColor: '#161619',
          primaryTextColor: '#e4e4e7',
          primaryBorderColor: 'rgba(74, 222, 128, 0.35)',
          lineColor: 'rgba(74, 222, 128, 0.85)',
          secondaryColor: '#0f0f12',
          tertiaryColor: '#1f1f23',
          edgeLabelBackground: '#09090b',
          nodeTextColor: '#e4e4e7',
          clusterBkg: '#0f0f12',
          titleColor: '#e4e4e7',
        },
      });
      for (const pre of diagrams) {
        const code = pre.querySelector('code');
        const text = (code ?? pre).textContent.trim();
        const id = 'mermaid-' + Math.random().toString(36).slice(2, 8);
        try {
          const { svg } = await mermaid.render(id, text);
          const wrapper = document.createElement('div');
          wrapper.className = 'mermaid-diagram';
          wrapper.innerHTML = svg;
          pre.replaceWith(wrapper);
        } catch (e) {}
      }
    }
  </script>

  <script>
    // Wrap tables so wide ones scroll horizontally instead of overflowing the viewport
    document.querySelectorAll('.prose-writeup table').forEach((table) => {
      const wrap = document.createElement('div');
      wrap.className = 'table-wrap';
      table.parentNode?.insertBefore(wrap, table);
      wrap.appendChild(table);
    });

    // TOC: always-open sticky sidebar on desktop, collapsed drawer on mobile
    const toc = document.getElementById('wuToc') as HTMLDetailsElement | null;
    if (toc) {
      const mq = window.matchMedia('(min-width: 1001px)');
      const syncToc = () => { toc.open = mq.matches; };
      syncToc();
      mq.addEventListener('change', syncToc);
      // Collapse after picking a heading on mobile
      toc.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => { if (!mq.matches) toc.open = false; })
      );
    }

    // Copy buttons on code blocks
    document.querySelectorAll('.prose-writeup pre').forEach((pre) => {
      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.type = 'button';
      btn.textContent = 'copy';
      btn.addEventListener('click', () => {
        const code = pre.querySelector('code');
        navigator.clipboard.writeText(code?.textContent ?? '').then(() => {
          btn.textContent = 'copied';
          setTimeout(() => (btn.textContent = 'copy'), 1600);
        });
      });
      (pre as HTMLElement).style.position = 'relative';
      pre.appendChild(btn);
    });

    // Active TOC heading via IntersectionObserver
    const headings = document.querySelectorAll<HTMLElement>('.prose-writeup h2, .prose-writeup h3');
    const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (links.length > 0) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              const id = (e.target as HTMLElement).id;
              let current: HTMLAnchorElement | null = null;
              links.forEach((l) => {
                const on = l.getAttribute('href') === `#${id}`;
                l.classList.toggle('active', on);
                if (on) current = l;
              });
              // The list scrolls on long writeups, so keep the highlighted
              // entry in view. 'nearest' is a no-op when it already is, and
              // stays instant, so there's no motion to suppress.
              if (current) {
                (current as HTMLAnchorElement).scrollIntoView({ block: 'nearest' });
              }
            }
          });
        },
        { rootMargin: '-15% 0% -70% 0%', threshold: 0 }
      );
      headings.forEach((h) => obs.observe(h));
    }

    // Reading-progress bar: fraction of the article scrolled past the viewport top
    const bar = document.getElementById('wuProgress');
    const article = document.querySelector('.wu-page');
    if (bar && article) {
      const update = () => {
        const rect = article.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const scrolled = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;
        bar.style.transform = `scaleX(${scrolled})`;
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update);
    }

    // Hover anchor links on headings (headings already carry slug ids)
    document.querySelectorAll<HTMLElement>('.prose-writeup h2[id], .prose-writeup h3[id]').forEach((h) => {
      if (h.querySelector('.wu-anchor')) return;
      const a = document.createElement('a');
      a.className = 'wu-anchor';
      a.href = `#${h.id}`;
      a.setAttribute('aria-label', 'Link to this section');
      a.textContent = '#';
      h.appendChild(a);
    });
  </script>
</BaseLayout>
<style>
  /* Reading progress, pinned under the fixed nav. */
  .wu-progress {
    position: fixed; top: 64px; left: 0; right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0); transform-origin: left;
    z-index: 99;
    will-change: transform;
  }

  /* TOC panel. Sticky sidebar from lg up, collapsible drawer below it, with
     the open state driven by the matchMedia sync in the script above. */
  .wu-toc summary::-webkit-details-marker { display: none; }
  .wu-toc-chevron { transition: transform .2s ease; }
  .wu-toc[open] .wu-toc-chevron { transform: rotate(180deg); }
  @media (min-width: 1024px) {
    .wu-toc-chevron { display: none; }
    .wu-toc-title { cursor: default; }
    .wu-toc-list { max-height: calc(100vh - 12rem); overflow-y: auto; }
  }

  /* Hover anchor links on headings (created client-side) */
  :global(.prose-writeup h2), :global(.prose-writeup h3) { position: relative; }
  :global(.wu-anchor) {
    position: absolute; left: -1.1em; top: 0;
    color: var(--fg-4); text-decoration: none; font-weight: 400;
    opacity: 0; transition: opacity .15s ease, color .15s ease;
  }
  :global(.wu-anchor:hover) { color: var(--accent); }
  :global(.wu-anchor:focus-visible) { opacity: 1; color: var(--accent); }
  @media (hover: hover) {
    :global(.prose-writeup h2:hover .wu-anchor),
    :global(.prose-writeup h3:hover .wu-anchor) { opacity: 1; }
  }
  @media (max-width: 900px) {
    /* No room for a hanging marker next to the text */
    :global(.wu-anchor) { display: none; }
  }

  :global(.mermaid-diagram) {
    background: var(--bg-2);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1.5rem;
    margin: 1.5rem 0;
    overflow-x: auto;
    text-align: center;
  }
  :global(.mermaid-diagram svg) { max-width: 100%; height: auto; }
</style>
