---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { ogCard } from '../utils/og';

interface Props {
  entry: CollectionEntry<'writeups'>;
  headings: MarkdownHeading[];
  readingTime: number;
  newer?: CollectionEntry<'writeups'> | null;
  older?: CollectionEntry<'writeups'> | null;
  related?: CollectionEntry<'writeups'>[];
}

const { entry, headings, readingTime, newer = null, older = null, related = [] } = Astro.props;
const { title, date, tags, difficulty, platform, description, scene, chain = [] } = entry.data;

const fmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(date);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const os = tags.includes('windows') ? 'Windows' : tags.includes('linux') ? 'Linux' : null;
const osIcon = os === 'Windows' ? 'monitor' : os === 'Linux' ? 'terminal' : null;
const card = ogCard(entry.slug);
---

<BaseLayout
  title={title}
  seoTitle={`${title} · HackTheBox Writeup`}
  description={description}
  image={card}
  article={{ published: date, tags }}
  writeup
>
  <header class="sec whead">
    {scene && <canvas id="scene" data-scene={scene} aria-hidden="true"></canvas>}
    <p class="crumb"><a href="/">certifa</a><span class="sep">/</span><a href="/writeups/">writeups</a><span class="sep">/</span>{entry.slug}</p>
    <h1>{title}</h1>
    <p class="wsum">{description}</p>
    <div class="wmeta">
      <span class="item"><span class={`diff ${difficulty}`}>{difficulty}</span></span>
      <span class="dot"></span>
      {osIcon && <><span class="item"><i data-i={osIcon}></i>{os}</span><span class="dot"></span></>}
      <span class="item"><i data-i="calendar"></i>{fmt}</span>
      <span class="dot"></span>
      <span class="item"><i data-i="clock"></i>~{readingTime} min read</span>
    </div>
    <div class="wtags">{tags.map((t) => <span>{t}</span>)}</div>
    {chain.length > 0 && (
      <div class="chainrail">
        {chain.map((s, i) => (
          <>
            {i > 0 && <span class="arr">&rsaquo;</span>}
            <span class:list={['step', { first: i === 0 }]}>{s}</span>
          </>
        ))}
      </div>
    )}
  </header>

  <div class="sec wbody">
    <nav class="toc" aria-label="On this page">
      <p>On this page</p>
      <ol>
        {toc.map((h) => (
          <li class:list={[{ sub: h.depth === 3 }]}><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </nav>

    <article class="article" id="wuBody"><slot /></article>
  </div>

  {related.length > 0 && (
    <section class="sec related">
      <p class="rel-k">Related writeups</p>
      <div class="rel-grid">
        {related.map((w) => (
          <a class="rel" href={`/writeups/${w.slug}/`}>
            <span class={`diff ${w.data.difficulty}`}>{w.data.difficulty}</span>
            <h4>{w.data.title}</h4>
            <p>{w.data.tags.slice(0, 3).join(' · ')}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <div class="sec pager">
    {older
      ? <a href={`/writeups/${older.slug}/`}><i data-i="back"></i>{older.data.title}</a>
      : <span></span>}
    <a class="all" href="/writeups/">All writeups</a>
    {newer
      ? <a href={`/writeups/${newer.slug}/`}>{newer.data.title}<i data-i="arrow"></i></a>
      : <span></span>}
  </div>
</BaseLayout>

<style is:global>
  html { scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }

  .whead { position: relative; padding-top: 48px; padding-bottom: 40px; overflow: hidden; }
  .whead canvas { position: absolute; right: -4%; top: -10%; width: 52%; height: 150%; opacity: .5; pointer-events: none;
    -webkit-mask-image: radial-gradient(ellipse 60% 60% at 60% 45%, #000 30%, transparent 72%);
    mask-image: radial-gradient(ellipse 60% 60% at 60% 45%, #000 30%, transparent 72%); }
  .whead .crumb { position: relative; font: 400 12.5px var(--mono); color: var(--dim); margin-bottom: 24px; }
  .whead .crumb a:hover { color: #fff; }
  .whead .crumb .sep { margin: 0 8px; color: #3a3a3a; }
  .whead h1 { position: relative; font-weight: 600; font-size: clamp(46px, 6vw, 86px); line-height: .95;
    letter-spacing: -.045em; text-transform: capitalize;
    filter: blur(18px); opacity: 0; transition: filter 1.1s cubic-bezier(.2,.7,.2,1), opacity 1.1s; }
  .ready .whead h1 { filter: none; opacity: 1; }
  .whead .wsum { position: relative; margin-top: 22px; max-width: 60ch; font-size: 17.5px; color: var(--muted); line-height: 1.5; }
  .wmeta { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-top: 26px;
    font: 400 12.5px var(--mono); color: var(--dim); text-transform: capitalize; }
  .wmeta i[data-i] { width: 14px; height: 14px; }
  .wmeta .item { display: inline-flex; align-items: center; gap: 7px; }
  .wmeta .dot { width: 3px; height: 3px; border-radius: 50%; background: #444; }
  .wtags { position: relative; display: flex; flex-wrap: wrap; gap: 6px; margin-top: 20px; }
  .wtags span { font: 400 11.5px var(--mono); color: #a8a8a8; border: 1px solid #2a2a2a; border-radius: 6px; padding: 3px 8px; }
  .chainrail { position: relative; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; margin-top: 30px;
    padding-top: 22px; border-top: 1px solid var(--line); }
  .chainrail .step { font: 400 12px var(--mono); color: #b8b8b8; background: #131313; border: 1px solid #242424; border-radius: 7px; padding: 5px 10px; }
  .chainrail .step.first { color: #c9d6ff; border-color: #3a4a7a; }
  .chainrail .arr { color: #555; }

  .wbody { display: grid; grid-template-columns: 200px 1fr; gap: 56px; align-items: start; padding-top: 50px; padding-bottom: 40px; }
  .toc { position: sticky; top: 30px; font-size: 13.5px; }
  .toc p { font: 400 11px var(--mono); color: var(--dim); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 14px; }
  .toc ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 2px; border-left: 1px solid var(--line); }
  .toc li.sub a { padding-left: 28px; font-size: 13px; color: #777; }
  .toc a { display: block; padding: 6px 0 6px 16px; margin-left: -1px; color: #8a8a8a; border-left: 1px solid transparent; transition: color .2s, border-color .2s; line-height: 1.3; }
  .toc a:hover { color: #ddd; }
  .toc a.on { color: #fff; border-left-color: var(--accent); }

  .article { min-width: 0; max-width: 760px; counter-reset: h2; }
  .article h2 { counter-increment: h2; font-weight: 600; font-size: 26px; letter-spacing: -.02em; margin: 46px 0 16px; scroll-margin-top: 24px; }
  .article h2::before { content: counter(h2, decimal-leading-zero); font: 400 13px var(--mono); color: var(--accent); margin-right: 12px; }
  .article h2:first-child { margin-top: 0; }
  .article h3 { font-weight: 600; font-size: 18px; letter-spacing: -.01em; margin: 30px 0 12px; color: #e8e8e8; scroll-margin-top: 24px; }
  .article p { color: #c9c9c9; font-size: 15.5px; line-height: 1.72; margin: 14px 0; }
  .article a[href^="http"] { color: #9bb8ff; border-bottom: 1px solid #2a3a6a; word-break: break-word; }
  .article a[href^="http"]:hover { border-color: var(--accent); }
  .article :not(pre) > code { font: 400 .86em var(--mono); color: #ffcf9e; background: rgba(255,179,107,.1); padding: 1px 5px; border-radius: 4px; word-break: break-word; }
  .article ul, .article ol { margin: 14px 0; padding-left: 0; list-style: none; display: grid; gap: 9px; }
  .article li { position: relative; padding-left: 22px; color: #c9c9c9; font-size: 15px; line-height: 1.6; }
  .article ul li::before { content: ""; position: absolute; left: 2px; top: 9px; width: 6px; height: 6px; border: 1px solid #555; }
  .article ol { counter-reset: li; }
  .article ol li::before { content: counter(li); counter-increment: li; position: absolute; left: 0; top: 0; font: 400 12px var(--mono); color: var(--accent); }

  .article table { width: 100%; border-collapse: collapse; margin: 18px 0; font-size: 14.5px; }
  .article thead { display: none; }
  .article table td { border: 1px solid var(--line); padding: 11px 14px; background: #0f0f0f; }
  .article table td:first-child { color: var(--dim); font: 400 12px var(--mono); text-transform: uppercase; letter-spacing: .04em; width: 1%; white-space: nowrap; }
  .article table td:last-child { font-weight: 500; }

  .article pre.astro-code { position: relative; margin: 18px 0; border: 1px solid #242424; border-radius: 11px;
    padding: 16px; overflow-x: auto; font: 400 12.5px/1.65 var(--mono); background: #0d0d0d !important; }
  .article pre.astro-code code { font: inherit; }
  .copybtn { position: absolute; top: 9px; right: 9px; cursor: pointer; display: inline-flex; align-items: center; gap: 5px;
    font: 400 11px var(--sans); color: #8a8a8a; background: #141414; padding: 4px 9px; border: 1px solid #2a2a2a; border-radius: 6px; transition: color .2s, border-color .2s; }
  .copybtn:hover { color: #fff; border-color: #444; }
  .copybtn.done { color: var(--easy); border-color: rgba(74,222,128,.4); }

  .article img { display: block; width: 100%; border: 1px solid var(--line); border-radius: 10px; background: #0d0d0d; margin: 20px 0; }

  .article blockquote { margin: 18px 0; padding: 12px 18px; border-left: 2px solid var(--accent); background: #0f0f0f; border-radius: 0 8px 8px 0; }
  .article blockquote p { margin: 0; color: var(--muted); font-size: 15px; }

  .related { padding-top: 10px; padding-bottom: 20px; }
  .rel-k { font: 400 11px var(--mono); color: var(--dim); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 16px; }
  .rel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .rel { display: block; border: 1px solid var(--line); border-radius: 12px; padding: 18px; transition: border-color .2s, background .2s; }
  .rel:hover { border-color: #333; background: #0f0f0f; }
  .rel .diff { display: inline-block; margin-bottom: 10px; }
  .rel h4 { font-weight: 600; font-size: 18px; letter-spacing: -.02em; text-transform: capitalize; }
  .rel p { margin-top: 6px; font: 400 12px var(--mono); color: var(--dim); }
  .pager { display: flex; justify-content: space-between; gap: 16px; align-items: center; border-top: 1px solid var(--line); padding-top: 26px; padding-bottom: 40px; font-size: 14px; }
  .pager a { display: inline-flex; align-items: center; gap: 8px; color: #cfcfcf; }
  .pager a:hover { color: #fff; }
  .pager a.all { color: var(--accent); }
  .pager i[data-i] { width: 14px; height: 14px; }

  @media (max-width: 980px) {
    .wbody { grid-template-columns: 1fr; gap: 28px; }
    .toc { position: static; border-bottom: 1px solid var(--line); padding-bottom: 20px; }
    .whead canvas { width: 70%; opacity: .3; }
    .article { max-width: none; }
    .rel-grid { grid-template-columns: 1fr; }
  }
</style>

<script src="/writeups/scenes.js" is:inline></script>
<script is:inline>
(() => {
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ICO = {
    terminal: '<path d="m4 17 6-6-6-6"/><path d="M12 19h8"/>',
    monitor: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
    clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    calendar: '<rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/>',
    arrow: '<path d="M7 17 17 7M8 7h9v9"/>',
    back: '<path d="M11 6 5 12l6 6M5 12h14"/>',
    copy: '<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/>',
    check: '<path d="M4 12.5 9 17.5 20 6.5"/>',
  };
  const svg = (p) => `<svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${p}</svg>`;
  document.querySelectorAll('i[data-i]').forEach((el) => {
    el.innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${ICO[el.dataset.i] || ''}</svg>`;
  });

  document.querySelectorAll('article pre.astro-code').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button'; btn.className = 'copybtn';
    btn.innerHTML = svg(ICO.copy) + 'copy';
    pre.appendChild(btn);
    btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(pre.querySelector('code').innerText); } catch {}
      btn.innerHTML = svg(ICO.check) + 'copied'; btn.classList.add('done');
      setTimeout(() => { btn.innerHTML = svg(ICO.copy) + 'copy'; btn.classList.remove('done'); }, 1800);
    });
  });

  setTimeout(() => document.body.classList.add('ready'), reduce ? 0 : 150);

  const links = [...document.querySelectorAll('.toc a')];
  const heads = links.map((a) => document.getElementById(a.getAttribute('href').slice(1))).filter(Boolean);
  if (heads.length) {
    const spy = () => {
      const y = scrollY + 120; let i = 0;
      heads.forEach((h, k) => { if (h.offsetTop <= y) i = k; });
      links.forEach((a, k) => a.classList.toggle('on', k === i));
    };
    addEventListener('scroll', spy, { passive: true }); spy();
  }

  const B = [0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5].map((v) => (v + 0.5) / 16), PX = 3;
  function surface(cv) {
    const dpr = devicePixelRatio || 1, w = cv.clientWidth, h = cv.clientHeight;
    if (cv.width !== w * dpr || cv.height !== h * dpr) { cv.width = w * dpr; cv.height = h * dpr; }
    const ctx = cv.getContext('2d'); ctx.setTransform(dpr, 0, 0, dpr, 0, 0); ctx.clearRect(0, 0, w, h); ctx.fillStyle = '#9a9a9a';
    return [ctx, Math.ceil(w / PX), Math.ceil(h / PX)];
  }

  const scv = document.getElementById('scene'), scene = scv && scv.dataset.scene;
  function drawScene(t) {
    if (!scv || !scv.clientWidth || !window.SCENES || !window.SCENES[scene]) return;
    const SW = 640, SH = 400, hi = document.createElement('canvas'); hi.width = SW; hi.height = SH;
    const g = hi.getContext('2d'); g.fillStyle = '#000'; g.fillRect(0, 0, SW, SH); window.SCENES[scene](g, t);
    const [ctx, cols, rows] = surface(scv);
    const off = document.createElement('canvas'); off.width = cols; off.height = rows;
    const o = off.getContext('2d'), r = Math.max(cols / SW, rows / SH);
    o.drawImage(hi, (cols - SW * r) / 2, (rows - SH * r) / 2, SW * r, SH * r);
    const d = o.getImageData(0, 0, cols, rows).data;
    for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
      if (d[(y * cols + x) * 4] / 255 > B[(y % 4) * 4 + (x % 4)]) ctx.fillRect(x * PX, y * PX, PX - 0.6, PX - 0.6);
    }
  }

  const wm = document.getElementById('wordmark');
  let mask = null, mw = 0;
  function wordmark(t) {
    if (!wm || !wm.clientWidth || !wm.clientHeight) return;
    const [ctx, cols, rows] = surface(wm);
    if (!mask || mw !== cols) {
      mw = cols; const off = document.createElement('canvas'); off.width = cols; off.height = rows; const o = off.getContext('2d');
      let size = rows; o.font = `600 ${size}px Geist, sans-serif`; size *= (cols * 0.96) / o.measureText('certifa').width;
      o.font = `600 ${size}px Geist, sans-serif`; o.textAlign = 'center'; o.fillStyle = '#fff'; o.fillText('certifa', cols / 2, rows * 0.86);
      mask = o.getImageData(0, 0, cols, rows).data;
    }
    const sweep = (t * 0.08) % 1.6 - 0.3;
    for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) {
      const a = mask[(y * cols + x) * 4 + 3] / 255; if (!a) continue;
      const val = a * (0.85 - (y / rows) * 0.6) + Math.max(0, 0.25 - Math.abs(x / cols - sweep) * 1.5);
      if (val > B[(y % 4) * 4 + (x % 4)]) ctx.fillRect(x * PX, y * PX, PX - 0.6, PX - 0.6);
    }
  }

  document.fonts.ready.then(() => {
    drawScene(0); wordmark(0);
    addEventListener('resize', () => { mask = null; drawScene(0); wordmark(0); });
    if (reduce) return;
    const seen = new Map(), io = new IntersectionObserver((es) => es.forEach((e) => seen.set(e.target, e.isIntersecting)));
    if (scv) io.observe(scv); if (wm) io.observe(wm);
    let last = 0;
    const loop = (n) => {
      if (!document.hidden && n - last > 90) { if (scv && seen.get(scv)) drawScene(n / 1000); if (wm && seen.get(wm)) wordmark(n / 1000); last = n; }
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);
  });
})();
</script>
