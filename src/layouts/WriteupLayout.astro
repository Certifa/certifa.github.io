---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import { ogCard } from '../utils/og';

interface Props {
  entry: CollectionEntry<'writeups'>;
  headings: MarkdownHeading[];
  readingTime: number;
  newer?: CollectionEntry<'writeups'> | null;
  older?: CollectionEntry<'writeups'> | null;
  related?: CollectionEntry<'writeups'>[];
}

const { entry, headings, readingTime, newer = null, older = null, related = [] } = Astro.props;
const { title, date, tags, difficulty, platform, description } = entry.data;

const fmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric',
}).format(date);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const os = tags.includes('windows') ? 'Windows' : tags.includes('linux') ? 'Linux' : null;
const card = ogCard(entry.slug);
---

<BaseLayout title={title} description={description} image={card}>
  <div class="prog" aria-hidden="true"><i id="prog"></i></div>

  <header class="whead">
    <a class="back" href="/writeups/">&larr; Back to writeups</a>
    <h1 class="wtitle">{title}</h1>
    <p class="wsub">{description}</p>
    <p class="meta">
      <span class="diff">{difficulty}</span>
      <span>{platform}</span>
      {os && <span>{os}</span>}
      <span>{fmt}</span>
      <span>~{readingTime} min read</span>
    </p>
    <div class="wtags">{tags.map((t) => <i>{t}</i>)}</div>
  </header>

  <div class="shell">
    <nav class="toc" id="toc" aria-label="On this page">
      <p>On this page</p>
      {toc.map((h) => (
        <a class:list={[{ sub: h.depth === 3 }]} href={`#${h.slug}`}>{h.text}</a>
      ))}
    </nav>

    <article class="body" id="wuBody"><slot /></article>
  </div>

  {related.length > 0 && (
    <section class="related">
      <p>Related writeups</p>
      <div class="rel-grid">
        {related.map((w) => (
          <a class="rel" href={`/writeups/${w.slug}/`}>
            <span class="wipe"></span>
            <span class="d">{w.data.difficulty} &middot; {w.data.platform}</span>
            <h4>{w.data.title}</h4>
            <p class="t">{w.data.tags.slice(0, 3).join(' · ')}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <div class="pager">
    {older
      ? <a href={`/writeups/${older.slug}/`}>&larr; Older &middot; {older.data.title}</a>
      : <span></span>}
    <a href="/writeups/">All writeups</a>
    {newer
      ? <a href={`/writeups/${newer.slug}/`}>Newer &middot; {newer.data.title} &rarr;</a>
      : <span></span>}
  </div>
</BaseLayout>

<style is:global>
  /* Long-form pages hold the grain still. A texture that re-renders every
     0.28s under body copy is a shimmer you read through. */
  .pagegrain { animation: none; opacity: .035; }

  /* reading progress, the only chrome that tracks how far you are */
  .prog { position: fixed; top: 0; left: 0; right: 0; height: 2px; z-index: 60; background: transparent; }
  .prog i { display: block; height: 100%; width: 0; background: var(--blood-lit);
    box-shadow: 0 0 10px rgba(193,31,31,.6); }

  /* ================= HEAD ================= */
  .whead { position: relative; padding: 20vh 4vw 5vh; border-bottom: 1px solid var(--line); }
  .whead::before { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse 50% 60% at 14% 50%, rgba(193,31,31,.09), transparent 70%); }
  .whead > * { position: relative; }
  .back { display: inline-block; font-size: .6rem; letter-spacing: .2em; text-transform: uppercase;
    color: var(--dim); text-decoration: none; margin-bottom: 4vh; transition: color .28s; }
  .back:hover { color: var(--blood-lit); }
  .wtitle { margin: 0; font-family: var(--display); font-weight: 400; text-transform: uppercase;
    font-size: clamp(2.6rem, 9vw, 7rem); line-height: .86; color: var(--bone); }
  .wsub { margin: 1.6em 0 0; max-width: 64ch; font-size: 1rem; line-height: 1.8; color: var(--read); }
  .meta { display: flex; gap: 1.7em; flex-wrap: wrap; margin-top: 3.4vh;
    font-size: .68rem; letter-spacing: .18em; text-transform: uppercase; color: var(--dim); }
  .meta .diff { color: var(--blood-lit); }
  .wtags { display: flex; gap: .5em; flex-wrap: wrap; margin-top: 2.6vh; }
  .wtags i { font-style: normal; font-size: .55rem; letter-spacing: .16em; text-transform: uppercase;
    color: #3a3732; border: 1px solid var(--line); padding: .45em .8em; }

  /* ================= LAYOUT ================= */
  .shell { display: grid; grid-template-columns: 290px 1fr; gap: 4vw;
    padding: 8vh 4vw 12vh; align-items: start; }

  /* ---- contents ----
     Long writeups run past the viewport, so the list scrolls, but the scrollbar
     is hidden and the list moves itself to keep the current section in view. */
  .toc { position: sticky; top: 12vh; max-height: 78vh; overflow-y: auto;
    scrollbar-width: none; -ms-overflow-style: none; scroll-behavior: smooth; }
  .toc::-webkit-scrollbar { width: 0; height: 0; }
  .toc p { margin: 0 0 1.8em; font-size: .64rem; letter-spacing: .24em;
    text-transform: uppercase; color: var(--blood-lit); }
  .toc a { display: block; font-size: .84rem; line-height: 1.5; color: #8a867f;
    text-decoration: none; padding: .58em 0 .58em 1.1em; border-left: 1px solid var(--line);
    transition: color .25s, border-color .25s; }
  .toc a:hover { color: var(--bone); }
  .toc a.sub { padding-left: 2.2em; font-size: .78rem; }
  .toc a.on { color: var(--bone); border-left-color: var(--blood-lit); }

  /* ---- prose ----
     The container does not cap everything, or evidence could never be wider
     than the prose. Reading elements carry the 66ch measure themselves. */
  .body { max-width: 58rem; min-width: 0; counter-reset: sec; }
  .body p, .body ul:not(.tldr):not(.lessons), .body ol, .body blockquote { max-width: 66ch; }

  .body h2 { margin: 3.6em 0 1.2em; padding-top: 1.8em; border-top: 1px solid var(--line);
    font-family: var(--display); font-weight: 400; text-transform: uppercase;
    font-size: clamp(1.35rem, 3vw, 2.2rem); line-height: 1; color: var(--bone);
    scroll-margin-top: 12vh; max-width: none; }
  .body h2::before { counter-increment: sec; content: counter(sec, decimal-leading-zero);
    display: block; font-family: var(--mono); font-size: .6rem; letter-spacing: .22em;
    color: var(--blood-lit); margin-bottom: 1.1em; }
  .body > :first-child.h2, .body h2:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
  .body h3 { margin: 2.6em 0 .9em; font-size: .92rem; letter-spacing: .1em; text-transform: uppercase;
    color: var(--blood-lit); scroll-margin-top: 12vh; }
  .body p { margin: 0 0 1.5em; font-size: 1.08rem; line-height: 1.8; color: var(--read); }
  .body strong { color: var(--bone); font-weight: 400; }
  .body a { color: var(--bone); text-decoration: none; border-bottom: 1px solid #3a3440;
    transition: color .28s, border-color .28s; }
  .body a:hover { color: var(--blood-lit); border-bottom-color: var(--blood-lit); }
  .body ul, .body ol { margin: 0 0 1.6em; padding-left: 1.3em; }
  .body li { font-size: 1.05rem; line-height: 1.8; color: var(--read); margin-bottom: .7em; }
  .body li::marker { color: var(--blood-lit); }
  .body :not(pre) > code { font-family: var(--mono); font-size: .86em; color: var(--bone);
    background: #141219; border: 1px solid var(--line); padding: .12em .45em; }

  /* ---- TL;DR: the section a skimmer reads, so it reads as a briefing ---- */
  .body ul.tldr { list-style: none; margin: 0 0 2em; padding: 24px 26px 26px;
    border: 1px solid var(--line); background: var(--panel); width: min(100%, 48rem); max-width: none; }
  .body ul.tldr li { position: relative; margin: 0; padding: 1.05em 0 0 1.8em;
    border-top: 1px solid var(--line); font-size: .98rem; line-height: 1.8; color: #b6b2aa; }
  .body ul.tldr li:first-child { border-top: 0; padding-top: 0; }
  .body ul.tldr li::marker { content: none; }
  .body ul.tldr li::before { content: '→'; position: absolute; left: 0; top: 1em;
    color: var(--blood-lit); font-size: .85em; }
  .body ul.tldr li:first-child::before { top: 0; }

  /* ---- Lessons: his best writing, so it stops looking like a bullet list ---- */
  .body ul.lessons { list-style: none; counter-reset: lesson; margin: 0 0 2em; padding: 0;
    display: grid; gap: 1px; background: var(--line); border: 1px solid var(--line);
    width: min(100%, 48rem); max-width: none; }
  .body ul.lessons li { background: var(--panel); margin: 0; padding: 26px 30px 28px;
    font-size: 1rem; line-height: 1.82; color: var(--read); }
  .body ul.lessons li::marker { content: none; }
  .body ul.lessons li::before { counter-increment: lesson;
    content: counter(lesson, decimal-leading-zero); display: block;
    font-family: var(--mono); font-size: .56rem; letter-spacing: .22em;
    color: var(--blood-lit); margin-bottom: 1.1em; }
  .body ul.lessons li > strong:first-child { display: block; font-family: var(--display);
    font-weight: 400; text-transform: uppercase; font-size: 1.02rem; line-height: 1.12;
    letter-spacing: .01em; color: var(--bone); margin-bottom: .8em; }

  /* ---- the overview table ---- */
  .body table { width: 100%; border-collapse: collapse; margin: 0 0 2em;
    border: 1px solid var(--line); max-width: none; }
  .body th, .body td { text-align: left; padding: 1em 1.2em; border-bottom: 1px solid var(--line);
    font-size: .88rem; font-weight: 400; }
  .body tr:last-child th, .body tr:last-child td { border-bottom: 0; }
  .body th { width: 12em; color: var(--dimmer); font-size: .58rem; letter-spacing: .2em;
    text-transform: uppercase; background: #0a090c; }
  .body td { color: var(--bone); }

  /* ---- code ----
     Evidence fills the column: half the code lines are 34 characters but the
     longest reach 146, and a command you cannot read is useless. */
  .cb { position: relative; margin: 0 0 .55em; background: var(--panel);
    border: 1px solid var(--line); width: 100%; max-width: none; }
  .cb + p, figure + p, .cb + h3, figure + h3 { margin-top: 2.6em; }
  .body p + .cb, .body p + figure { margin-top: 1.4em; }
  .cbar { display: flex; align-items: center; justify-content: space-between;
    padding: 11px 16px; border-bottom: 1px solid var(--line);
    font-size: .62rem; letter-spacing: .18em; text-transform: uppercase; color: var(--dimmer); }
  /* a named fence is something he ran; an unlabelled one is what came back */
  .cb.cmd { border-left: 2px solid #4d1616; }
  .cb.cmd .cbar span:first-child { color: var(--blood-lit); }
  .cb.out { background: #08070a; }
  .body pre { margin: 0 !important; padding: 22px 20px !important; font-size: .85rem;
    line-height: 1.8; overflow-x: auto; background: transparent !important; }
  .cb.out pre { font-size: .8rem; }
  .body pre code { font-family: var(--mono); background: none; border: 0; padding: 0; }
  .copy { font-family: var(--mono); font-size: .56rem; letter-spacing: .18em;
    text-transform: uppercase; background: transparent; border: 1px solid var(--line);
    color: var(--dimmer); padding: .5em .9em; cursor: pointer;
    transition: color .25s, border-color .25s; }
  .copy:hover { color: var(--bone); border-color: var(--blood-lit); }
  .copy.done { color: var(--blood-lit); border-color: var(--blood-lit); }

  /* a line that matters more than the rest of the block */
  .body blockquote { margin: 0 0 2em; padding: 18px 20px; border-left: 2px solid var(--blood-lit);
    background: #0a090c; font-size: 1rem; line-height: 1.85; color: var(--read); }
  .body blockquote p:last-child { margin-bottom: 0; }

  /* ---- screenshots ---- */
  .body figure { margin: 0 0 .55em; border: 1px solid var(--line); padding: 0;
    width: 100%; max-width: none; }
  .body figure img { display: block; width: 100%; height: auto; }
  .body figcaption { margin: .95em .2em .1em; font-size: .66rem; letter-spacing: .1em;
    color: var(--dimmer); display: flex; gap: .7em; align-items: baseline; }
  .body figcaption::before { content: ''; width: 14px; height: 1px; background: var(--blood-lit);
    flex: 0 0 auto; transform: translateY(-.35em); }
  .body > p > img { display: block; width: 100%; height: auto; border: 1px solid var(--line); }

  /* ---- the embargo panel, styled from the markdown's own classes ---- */
  .wu-locked { border: 1px solid var(--line); background: #0a090c; padding: 44px 34px;
    text-align: center; max-width: none; }
  .wu-locked-icon { width: 34px; height: 34px; color: var(--blood-lit); margin-bottom: 1.4em; }
  .wu-locked-kicker { margin: 0 0 1em !important; font-size: .56rem; letter-spacing: .28em;
    text-transform: uppercase; color: var(--blood-lit); }
  .wu-locked h2 { margin: 0 0 1em !important; padding: 0 !important; border: 0 !important;
    font-size: clamp(1.3rem, 3vw, 2rem); }
  .wu-locked h2::before { content: none !important; }
  .wu-locked p { margin: 0 auto !important; max-width: 52ch; font-size: .9rem; }
  .wu-locked-foot { margin-top: 1.6em !important; font-size: .62rem; letter-spacing: .18em;
    text-transform: uppercase; color: var(--dimmer); }

  /* ================= RELATED / NAV ================= */
  .related { padding: 0 4vw 6vh; }
  .related > p { margin: 0 0 4vh; font-size: .6rem; letter-spacing: .32em;
    text-transform: uppercase; color: var(--dimmer); }
  .rel-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: 1px; }
  .rel { position: relative; background: var(--panel); padding: 26px 24px 28px; overflow: hidden;
    text-decoration: none; display: block; box-shadow: 0 0 0 1px var(--line);
    transition: background .3s; }
  .rel:hover { background: #100e14; }
  .rel .wipe { position: absolute; left: 0; right: 0; top: 0; height: 2px;
    background: var(--blood-lit); transform: scaleX(0); transform-origin: left;
    pointer-events: none; transition: transform .45s cubic-bezier(.2,0,0,1); }
  .rel:hover .wipe { transform: scaleX(1); }
  .rel .d { font-size: .55rem; letter-spacing: .22em; text-transform: uppercase; color: var(--dimmer); }
  .rel h4 { margin: 1.3em 0 0; font-family: var(--display); font-weight: 400;
    text-transform: uppercase; font-size: 1.25rem; line-height: 1; color: var(--bone); }
  .rel .t { margin: 1em 0 0; font-size: .66rem; letter-spacing: .12em; color: #3a3732; }

  .pager { display: flex; justify-content: space-between; gap: 2em; flex-wrap: wrap;
    padding: 0 4vw 14vh; }
  .pager a { font-size: .62rem; letter-spacing: .2em; text-transform: uppercase; color: var(--dim);
    text-decoration: none; border: 1px solid var(--line); padding: 1.1em 1.7em;
    transition: border-color .3s, color .3s; }
  .pager a:hover { border-color: var(--blood-lit); color: var(--bone); }

  @media (max-width: 980px) {
    .shell { grid-template-columns: 1fr; gap: 0; }
    .toc { position: static; max-height: none; margin-bottom: 6vh;
      border: 1px solid var(--line); padding: 22px 20px; }
    .whead { padding-top: 16vh; }
  }
</style>

<script>
  /* Astro renders the markdown; this adds the chrome the design needs on top of
     it. Doing it here rather than in the markdown means the content files stay
     plain and portable. */
  const body = document.getElementById('wuBody');

  if (body) {
    // Code blocks become panels. A fence with a language is a command he ran;
    // an unlabelled one is what came back, and they should not look the same.
    body.querySelectorAll('pre').forEach((pre) => {
      const lang = pre.getAttribute('data-language') || '';
      const isCmd = lang && lang !== 'plaintext' && lang !== 'text';
      const box = document.createElement('div');
      box.className = `cb ${isCmd ? 'cmd' : 'out'}`;
      const bar = document.createElement('div');
      bar.className = 'cbar';
      bar.innerHTML = `<span>${isCmd ? lang : 'output'}</span>`;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'copy';
      btn.textContent = 'Copy';
      bar.appendChild(btn);
      pre.replaceWith(box);
      box.append(bar, pre);
    });

    // The summary and the takeaways stop being ordinary bullet lists.
    const mark = (slug: string, cls: string) => {
      const h = document.getElementById(slug);
      let n = h?.nextElementSibling;
      while (n && n.tagName !== 'UL' && n.tagName !== 'H2') n = n.nextElementSibling;
      if (n && n.tagName === 'UL') n.classList.add(cls);
    };
    mark('tldr', 'tldr');
    mark('tl-dr', 'tldr');
    mark('lessons-learned', 'lessons');

    // Images become figures so the alt text can caption them.
    body.querySelectorAll('p > img').forEach((img) => {
      const p = img.parentElement!;
      if (p.childNodes.length !== 1) return;
      const fig = document.createElement('figure');
      const alt = img.getAttribute('alt') || '';
      p.replaceWith(fig);
      fig.appendChild(img);
      if (alt.trim()) {
        const cap = document.createElement('figcaption');
        cap.textContent = alt;
        fig.appendChild(cap);
      }
    });
  }

  // Copy, with a fallback: the async clipboard needs a secure context, and this
  // button exists to hand over commands.
  document.querySelectorAll('.copy').forEach((button) => {
    button.addEventListener('click', async () => {
      const code = (button.closest('.cb')?.querySelector('pre') as HTMLElement)?.innerText ?? '';
      let copied = false;
      try {
        await navigator.clipboard.writeText(code);
        copied = true;
      } catch {
        const scratch = document.createElement('textarea');
        scratch.value = code;
        scratch.setAttribute('readonly', '');
        scratch.style.cssText = 'position:fixed;top:-9999px';
        document.body.appendChild(scratch);
        scratch.select();
        try { copied = document.execCommand('copy'); } catch { copied = false; }
        scratch.remove();
      }
      button.textContent = copied ? 'Copied' : 'Press Ctrl+C';
      button.classList.toggle('done', copied);
      setTimeout(() => { button.textContent = 'Copy'; button.classList.remove('done'); }, 1600);
    });
  });

  // Reading progress
  const prog = document.getElementById('prog');
  const onScroll = () => {
    if (!prog) return;
    const max = document.documentElement.scrollHeight - innerHeight;
    prog.style.width = (max > 0 ? (scrollY / max) * 100 : 0) + '%';
  };
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  /* Scroll spy. Tracks the heading nearest the top rather than whichever one
     intersects, so short sections still register as you pass them. */
  const toc = document.getElementById('toc');
  const links = [...document.querySelectorAll('.toc a')] as HTMLAnchorElement[];
  const targets = links.map((a) => document.getElementById(a.getAttribute('href')!.slice(1)));
  let lastActive: HTMLAnchorElement | null = null;

  function spy() {
    const line = innerHeight * 0.22;
    let current = 0;
    targets.forEach((section, index) => {
      if (section && section.getBoundingClientRect().top <= line) current = index;
    });
    links.forEach((a, index) => a.classList.toggle('on', index === current));

    // Keep the current entry visible without the reader ever scrolling the list.
    const active = links[current];
    if (toc && active && active !== lastActive) {
      lastActive = active;
      const box = toc.getBoundingClientRect();
      const row = active.getBoundingClientRect();
      if (row.top < box.top + 8 || row.bottom > box.bottom - 8) {
        toc.scrollTo({ top: active.offsetTop - toc.clientHeight / 2, behavior: 'smooth' });
      }
    }
  }
  if (links.length) { spy(); addEventListener('scroll', spy, { passive: true }); }
</script>
