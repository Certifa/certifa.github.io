---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ogCard } from '../utils/og';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /**
   * Overrides the <title> only, leaving `title` for the share card alt and the
   * JSON-LD headline. A page is titled for the reader on the page and for a
   * search result separately: "Shocker" is right in one place and useless in
   * the other, where the query is "htb shocker writeup".
   */
  seoTitle?: string;
  /** Share card, site-root-relative. Writeups pass their generated /og/<box>.png. */
  image?: string;
  /** Present on a writeup. Switches og:type and emits TechArticle JSON-LD. */
  article?: { published: Date; tags?: string[] };
}

const {
  title = 'Certifa',
  description = 'Offensive security student. HackTheBox writeups across Active Directory, Linux, and web.',
  seoTitle,
  image,
  article,
} = Astro.props;

/**
 * Google truncates a description around 155 characters. A longer one is not
 * penalised, it is simply cut mid-sentence in the result, so the last thing a
 * searcher reads is an ellipsis instead of the reason to click.
 */
const clamp = (text: string, max = 155) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  const space = cut.lastIndexOf(' ');
  return (space > max - 30 ? cut.slice(0, space) : cut).replace(/[,;:\s]+$/, '') + '...';
};
const metaDescription = clamp(description);

// Shell pages have their own generated card; writeups pass theirs in.
const SHELL_CARDS: Record<string, string> = {
  '/': ogCard('home'),
  '/writeups': ogCard('writeups'),
  '/about': ogCard('about'),
  '/projects': ogCard('projects'),
  '/contact': ogCard('contact'),
};
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
// A page that is not mapped above still shares with the site card rather than
// with nothing. No og:image at all is the one outcome that looks broken, and
// it would happen silently the next time a page is added.
const resolved = image ?? SHELL_CARDS[currentPath] ?? ogCard('home');
const ogImage = resolved ? new URL(resolved, Astro.site).href : null;

const displayTitle = seoTitle ?? title;
const siteTitle = displayTitle === 'Certifa' ? displayTitle : `${displayTitle} · Certifa`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

/**
 * Structured data. A writeup is a TechArticle so the date, author and subject
 * are machine-readable rather than inferred from prose; everything else
 * describes the site itself.
 */
const schema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: title,
      description: metaDescription,
      datePublished: article.published.toISOString(),
      dateModified: article.published.toISOString(),
      image: ogImage ?? undefined,
      mainEntityOfPage: canonicalUrl,
      keywords: (article.tags ?? []).join(', '),
      author: { '@type': 'Person', name: 'Certifa', url: 'https://certifa.net/about/' },
      publisher: { '@type': 'Person', name: 'Certifa', url: 'https://certifa.net/' },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Certifa',
      url: 'https://certifa.net/',
      description: metaDescription,
      author: { '@type': 'Person', name: 'Certifa', url: 'https://certifa.net/about/' },
    };
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        <meta property="article:author" content="Certifa" />
        {(article.tags ?? []).map((t) => <meta property="article:tag" content={t} />)}
      </>
    )}
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:site_name" content="Certifa" />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Feed readers look for this; without it /rss.xml is only findable
         by guessing the URL. -->
    <link rel="alternate" type="application/rss+xml" title="Certifa · Writeups" href="/rss.xml" />
    <meta name="theme-color" content="#050406" />
  </head>
  <body>
    <div class="pagegrain" aria-hidden="true"></div>
    <span id="top"></span>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />

    <div class="copy-toast" id="copyToast">Copied</div>

    <script>
      // Scroll reveal
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('revealed');
            io.unobserve(e.target);
          }
        }),
        { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Copy-to-clipboard via [data-copy="value"]
      const toast = document.getElementById('copyToast');
      let toastTimer: number | undefined;
      document.body.addEventListener('click', (e) => {
        const el = (e.target as HTMLElement).closest('[data-copy]') as HTMLElement | null;
        if (!el || !toast) return;
        const val = el.getAttribute('data-copy') || '';
        if (navigator.clipboard) navigator.clipboard.writeText(val).catch(() => {});
        toast.textContent = `Copied → ${val}`;
        toast.classList.add('show');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = window.setTimeout(() => toast.classList.remove('show'), 1600);
      });
    </script>
  </body>
</html>
