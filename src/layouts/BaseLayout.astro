---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ogCard } from '../utils/og';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Overrides <title> only, leaving `title` for the share card alt and JSON-LD. */
  seoTitle?: string;
  /** Share card, site-root-relative. Writeups pass their generated /og/<box>.png. */
  image?: string;
  /** Present on a writeup. Switches og:type and emits TechArticle JSON-LD. */
  article?: { published: Date; tags?: string[] };
  /** Writeup pages opt out of smooth scroll: long reading pages read better native. */
  writeup?: boolean;
}

const {
  title = 'Certifa',
  description = 'Offensive security student. HackTheBox writeups across Active Directory, Linux, and web.',
  seoTitle,
  image,
  article,
  writeup = false,
} = Astro.props;

const clamp = (text: string, max = 155) => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  const space = cut.lastIndexOf(' ');
  return (space > max - 30 ? cut.slice(0, space) : cut).replace(/[,;:\s]+$/, '') + '...';
};
const metaDescription = clamp(description);

const SHELL_CARDS: Record<string, string> = {
  '/': ogCard('home'),
  '/writeups': ogCard('writeups'),
  '/about': ogCard('about'),
  '/projects': ogCard('projects'),
  '/contact': ogCard('contact'),
};
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const resolved = image ?? SHELL_CARDS[currentPath] ?? ogCard('home');
const ogImage = resolved ? new URL(resolved, Astro.site).href : null;

const displayTitle = seoTitle ?? title;
const siteTitle = displayTitle.startsWith('Certifa') ? displayTitle : `${displayTitle} · Certifa`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

const schema = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'TechArticle',
      headline: title,
      description: metaDescription,
      datePublished: article.published.toISOString(),
      dateModified: article.published.toISOString(),
      image: ogImage ?? undefined,
      mainEntityOfPage: canonicalUrl,
      keywords: (article.tags ?? []).join(', '),
      author: { '@type': 'Person', name: 'Certifa', url: 'https://certifa.net/about/' },
      publisher: { '@type': 'Person', name: 'Certifa', url: 'https://certifa.net/' },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Certifa',
      url: 'https://certifa.net/',
      description: metaDescription,
      author: { '@type': 'Person', name: 'Certifa', url: 'https://certifa.net/about/' },
    };
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{siteTitle}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        <meta property="article:author" content="Certifa" />
        {(article.tags ?? []).map((t) => <meta property="article:tag" content={t} />)}
      </>
    )}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Certifa" />
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={title} />
        <meta name="twitter:image" content={ogImage} />
      </>
    )}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title="Certifa · Writeups" href="/rss.xml" />
    <meta name="theme-color" content="#0a0a0a" />
  </head>
  <body data-writeup={writeup ? '1' : undefined}>
    <!-- The chalk filter the wireframe icons reference as url(#chalk). It must
         exist on every page that draws one: a reference to a missing filter
         makes the browser skip the element entirely, so the icons vanish. -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="chalk" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="1.8" result="d" />
        <feGaussianBlur in="d" stdDeviation="2.4" result="g" />
        <feMerge><feMergeNode in="g" /><feMergeNode in="d" /></feMerge>
      </filter>
    </svg>
    <div class="progress" id="progress" aria-hidden="true"></div>
    <span id="top"></span>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main-content" tabindex="-1"><slot /></main>
    <Footer />

    <script>
      import Lenis from 'lenis';
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const writeup = document.body.dataset.writeup === '1';

      if (!reduce && !writeup) {
        const lenis = new Lenis({ lerp: 0.09 });
        const raf = (t: number) => { lenis.raf(t); requestAnimationFrame(raf); };
        requestAnimationFrame(raf);
      }
      setTimeout(() => document.body.classList.add('ready'), reduce ? 0 : 150);

      const bar = document.getElementById('progress');
      if (bar) {
        const prog = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
        };
        addEventListener('scroll', prog, { passive: true });
        prog();
      }

      document.body.addEventListener('click', async (e) => {
        const el = (e.target as HTMLElement).closest('[data-copy]') as HTMLElement | null;
        if (!el) return;
        const val = el.getAttribute('data-copy') || '';
        try { await navigator.clipboard.writeText(val); } catch {}
        const small = el.querySelector('small');
        if (small) {
          const was = small.textContent;
          small.textContent = 'Copied';
          setTimeout(() => { small.textContent = was; }, 1600);
        }
      });

      // Each page draws its own footer wordmark (ported from the prototype),
      // so nothing shared touches the #wordmark canvas here.
    </script>
  </body>
</html>
